  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport { createServer as createViteServer } from \"vite\";\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json());\n\n// Initialize Gemini SDK with process.env.GEMINI_API_KEY\nfunction getGeminiClient(): GoogleGenAI {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey) {\n    throw new Error(\"GEMINI_API_KEY is not defined\");\n  }\n  return new GoogleGenAI({ apiKey });\n}\n\n// 1. Prospect Discovery via Search & Maps grounding\napp.post(\"/api/prospects/search\", async (req, res) => {\n  try {\n    const { sector, city, specialty, freelanceProfile } = req.body;\n    if (!sector || !city) {\n      return res.status(400).json({ error: \"Secteur et ville requis\" });\n    }\n\n    const ai = getGeminiClient();\n\n    const prompt = `Trouve entre 6 et 10 entreprises, commerces, artisans, cabinets ou professionnels r\303\251els situ\303\251s \303\240 ${city} et ses alentours imm\303\251diats dans le secteur: \"${sector}\" ${specialty ? `(sp\303\251cificit\303\251: ${specialty})` : \'\'}.\nCe freelance offre: \"${freelanceProfile?.services || \'cr\303\251ation web, refonte, visibilit\303\251 locale, acquisition\'}\".\n\nPour chaque prospect identifi\303\251:\n- Nom de l\'entreprise\n- Type d\'activit\303\251 pr\303\251cise\n- Adresse ou quartier \303\240 ${city}\n- T\303\251l\303\251phone (si disponible)\n- Site web (s\'il existe, ou mentionner \'Aucun site\' si manquant)\n- Note / avis Google Maps si trouv\303\251s\n- Email de contact g\303\251n\303\251rique ou dirigeant (si trouvable publiquement, sinon \'\')\n- Angle d\'opportunit\303\251 pr\303\251cis pour ce freelance (ex: site non responsive, pas de r\303\251servation en ligne, manque de visibilit\303\251 Google, potentiel de refonte, communication digitale absente)\n- Note de pertinence de 1 \303\240 10 pour ce freelance\n\nRetourne un tableau JSON structur\303\251.`;\n\n    // As mandated: L\342\200\231unique variable \303\240 utiliser pour l\342\200\231appel a l\342\200\231api gemini est gemini-flash-latest\n    const response = await ai.models.generateContent({\n      model: \"gemini-flash-latest\",\n      contents: prompt,\n      config: {\n        tools: [{ googleSearch: {} }],\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.ARRAY,\n          description: \"Liste des prospects locaux trouv\303\251s\",\n          items: {\n            type: Type.OBJECT,\n            properties: {\n              name: { type: Type.STRING },\n              activity: { type: Type.STRING },\n              location: { type: Type.STRING },\n              address: { type: Type.STRING },\n              phone: { type: Type.STRING },\n              website: { type: Type.STRING },\n              email: { type: Type.STRING },\n              rating: { type: Type.NUMBER },\n              reviewCount: { type: Type.NUMBER },\n              keyAngle: { type: Type.STRING },\n              relevanceScore: { type: Type.NUMBER }\n            },\n            required: [\"name\", \"activity\", \"location\", \"keyAngle\"]\n          }\n        }\n      }\n    });\n\n    const text = response.text;\n    let prospects = [];\n    try {\n      prospects = JSON.parse(text || \"[]\");\n    } catch {\n      prospects = [];\n    }\n\n    // Add unique IDs and default statuses\n    const formatted = prospects.map((p: any, idx: number) => ({\n      id: `p_${Date.now()}_${idx}`,\n      name: p.name || `Prospect ${idx + 1}`,\n      activity: p.activity || sector,\n      location: p.location || city,\n      address: p.address || \"\",\n      phone: p.phone || \"\",\n      website: p.website || \"\",\n      email: p.email || \"\",\n      rating: p.rating || 0,\n      reviewCount: p.reviewCount || 0,\n      keyAngle: p.keyAngle || \"Opportunit\303\251 de collaboration locale\",\n      relevanceScore: p.relevanceScore || 8,\n      status: \"to_contact\",\n      notes: \"\"\n    }));\n\n    return res.json({ prospects: formatted });\n  } catch (error: any) {\n    console.error(\"Search error:\", error);\n    return res.status(500).json({ error: error.message || \"Erreur lors de la recherche\" });\n  }\n});\n\n// 2. Personalized email generation per prospect\napp.post(\"/api/prospects/generate-email\", async (req, res) => {\n  try {\n    const { prospect, freelanceProfile, tone, objective } = req.body;\n    if (!prospect) {\n      return res.status(400).json({ error: \"Prospect requis\" });\n    }\n\n    const ai = getGeminiClient();\n\n    const prompt = `R\303\251dige un email de prospection sur mesure, professionnel, direct et concis (maximum 120-150 mots) pour un freelance qui contacte ce prospect local.\n\nInformations sur le prospect:\n- Entreprise: ${prospect.name}\n- Activit\303\251: ${prospect.activity}\n- Localisation: ${prospect.location}\n- Site web: ${prospect.website || \'Pas de site r\303\251pertori\303\251\'}\n- Avis / R\303\251putation: ${prospect.rating ? `${prospect.rating}/5 (${prospect.reviewCount || 0} avis)` : \'Non renseign\303\251\'}\n- Angle cl\303\251 identifi\303\251: ${prospect.keyAngle || \'Am\303\251lioration de visibilit\303\251 locale\'}\n- Notes \303\251ventuelles: ${prospect.notes || \'Aucune\'}\n\nInformations sur le freelance:\n- M\303\251tier: ${freelanceProfile?.title || \'Freelance Web & Digital\'}\n- Comp\303\251tences: ${freelanceProfile?.services || \'Cr\303\251ation de site internet moderne, SEO local, optimisation conversion\'}\n- Proposition de valeur: ${freelanceProfile?.valueProposition || \'Aider les acteurs locaux \303\240 g\303\251n\303\251rer plus de clients gr\303\242ce \303\240 une pr\303\251sence num\303\251rique percutante\'}\n- Portfolio / Lien: ${freelanceProfile?.portfolioUrl || \'\'}\n\nObjectif de l\'email: ${objective || \'Proposer un \303\251change rapide de 10 min ou un audit offert sans engagement\'}\nTon souhait\303\251: ${tone || \'Courtois, percutant, orient\303\251 valeur concr\303\250te, sans jargon inutile\'}\n\nL\'email doit :\n1. Avoir un objet clair et personnalis\303\251 qui suscite l\'ouverture sans faire spam.\n2. Montrer imm\303\251diatement qu\'on conna\303\256t l\'activit\303\251 de l\'entreprise locale et mentionner l\'angle cl\303\251 sp\303\251cifique.\n3. Proposer un appel \303\240 l\'action simple et sans friction.\n4. Pas de formule pompeuse ni de fausse promesse.\n\nRetourne un JSON strict.`;\n\n    // Mandated: model is gemini-flash-latest\n    const response = await ai.models.generateContent({\n      model: \"gemini-flash-latest\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            subject: { type: Type.STRING, description: \"Objet du mail\" },\n            body: { type: Type.STRING, description: \"Corps du mail pr\303\252t \303\240 l\'envoi\" }\n          },\n          required: [\"subject\", \"body\"]\n        }\n      }\n    });\n\n    const parsed = JSON.parse(response.text || \"{}\");\n    return res.json(parsed);\n  } catch (error: any) {\n    console.error(\"Email generation error:\", error);\n    return res.status(500).json({ error: error.message || \"Erreur de g\303\251n\303\251ration du mail\" });\n  }\n});\n\n// 3. Send email via Gmail API using client\'s access token\napp.post(\"/api/gmail/send\", async (req, res) => {\n  try {\n    const authHeader = req.headers.authorization;\n    if (!authHeader || !authHeader.startsWith(\"Bearer \")) {\n      return res.status(401).json({ error: \"Jeton d\'autorisation Gmail manquant\" });\n    }\n    const token = authHeader.substring(7);\n\n    const { to, subject, body } = req.body;\n    if (!to || !subject || !body) {\n      return res.status(400).json({ error: \"Destinataire, objet et corps requis\" });\n    }\n\n    // Build RFC 2822 email format\n    const utf8Subject = `=?utf-8?B?${Buffer.from(subject).toString(\"base64\")}?=`;\n    const messageParts = [\n      `To: ${to}`,\n      `Subject: ${utf8Subject}`,\n      \"MIME-Version: 1.0\",\n      \"Content-Type: text/plain; charset=UTF-8\",\n      \"Content-Transfer-Encoding: 7bit\",\n      \"\",\n      body,\n    ];\n    const message = messageParts.join(\"\\r\\n\");\n\n    // Base64url encode\n    const encodedMessage = Buffer.from(message)\n      .toString(\"base64\")\n      .replace(/\\+/g, \"-\")\n      .replace(/\\//g, \"_\")\n      .replace(/=+$/, \"\");\n\n    const gmailRes = await fetch(\n      \"https://gmail.googleapis.com/gmail/v1/users/me/messages/send\",\n      {\n        method: \"POST\",\n        headers: {\n          Authorization: `Bearer ${token}`,\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify({ raw: encodedMessage }),\n      }\n    );\n\n    if (!gmailRes.ok) {\n      const errData = await gmailRes.json().catch(() => ({}));\n      return res.status(gmailRes.status).json({\n        error: errData.error?.message || \"\303\211chec de l\'envoi via Gmail\",\n      });\n    }\n\n    const result = await gmailRes.json();\n    return res.json({ success: true, messageId: result.id });\n  } catch (error: any) {\n    console.error(\"Gmail send error:\", error);\n    return res.status(500).json({ error: error.message || \"Erreur lors de l\'envoi\" });\n  }\n});\n\n// 4. Create Draft via Gmail API\napp.post(\"/api/gmail/draft\", async (req, res) => {\n  try {\n    const authHeader = req.headers.authorization;\n    if (!authHeader || !authHeader.startsWith(\"Bearer \")) {\n      return res.status(401).json({ error: \"Jeton d\'autorisation Gmail manquant\" });\n    }\n    const token = authHeader.substring(7);\n\n    const { to, subject, body } = req.body;\n\n    const utf8Subject = subject ? `=?utf-8?B?${Buffer.from(subject).toString(\"base64\")}?=` : \"\";\n    const messageParts = [\n      to ? `To: ${to}` : \"\",\n      `Subject: ${utf8Subject}`,\n      \"MIME-Version: 1.0\",\n      \"Content-Type: text/plain; charset=UTF-8\",\n      \"Content-Transfer-Encoding: 7bit\",\n      \"\",\n      body || \"\",\n    ].filter(Boolean);\n    const message = messageParts.join(\"\\r\\n\");\n\n    const encodedMessage = Buffer.from(message)\n      .toString(\"base64\")\n      .replace(/\\+/g, \"-\")\n      .replace(/\\//g, \"_\")\n      .replace(/=+$/, \"\");\n\n    const draftRes = await fetch(\n      \"https://gmail.googleapis.com/gmail/v1/users/me/drafts\",\n      {\n        method: \"POST\",\n        headers: {\n          Authorization: `Bearer ${token}`,\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify({\n          message: { raw: encodedMessage }\n        }),\n      }\n    );\n\n    if (!draftRes.ok) {\n      const errData = await draftRes.json().catch(() => ({}));\n      return res.status(draftRes.status).json({\n        error: errData.error?.message || \"\303\211chec de la cr\303\251ation du brouillon Gmail\",\n      });\n    }\n\n    const result = await draftRes.json();\n    return res.json({ success: true, draftId: result.id });\n  } catch (error: any) {\n    console.error(\"Gmail draft error:\", error);\n    return res.status(500).json({ error: error.message || \"Erreur cr\303\251ation brouillon\" });\n  }\n});\n\n// Vite middleware or static serving\nasync function startServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (_req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running on port ${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
