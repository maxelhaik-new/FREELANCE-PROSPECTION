    end_line: 294
    content: "import React, { useState, useEffect } from \"react\";\nimport { \n  Building2, \n  MapPin, \n  Send, \n  Sparkles, \n  Mail, \n  CheckCircle2, \n  Search, \n  Plus, \n  Filter, \n  RefreshCw,\n  SlidersHorizontal,\n  ChevronDown\n} from \"lucide-react\";\nimport { motion } from \"motion/react\";\nimport { Prospect, FreelanceProfile, SearchQuery } from \"./types\";\nimport { StatsBento } from \"./components/StatsBento\";\nimport { SearchPanel } from \"./components/SearchPanel\";\nimport { ProspectList } from \"./components/ProspectList\";\nimport { ProspectDetailModal } from \"./components/ProspectDetailModal\";\nimport { GmailAuth } from \"./components/GmailAuth\";\n\nconst INITIAL_PROFILE: FreelanceProfile = {\n  title: \"Freelance Web & Visibilit\303\251 Locale\",\n  services: \"Refonte de site moderne, SEO Google Maps, optimisation conversion, devis en ligne\",\n  targetSector: \"Commerces & Artisans\",\n  targetCity: \"Bordeaux\",\n  valueProposition: \"Aider les acteurs locaux \303\240 transformer leurs visiteurs en clients et moderniser leur image.\",\n};\n\nconst INITIAL_PROSPECTS: Prospect[] = [\n  {\n    id: \"p_init_1\",\n    name: \"Boulangerie L\'\303\211pi Dor\303\251\",\n    activity: \"Boulangerie P\303\242tisserie Artisanale\",\n    location: \"Bordeaux Centre (Saint-Pierre)\",\n    phone: \"05 56 44 12 89\",\n    website: \"\",\n    email: \"contact@lepidore-bordeaux.fr\",\n    rating: 4.6,\n    reviewCount: 124,\n    status: \"to_contact\",\n    relevanceScore: 9,\n    keyAngle: \"Forte affluence locale et tr\303\250s bonnes notes, mais absence de site web et pas de syst\303\250me de commande ou g\303\242teaux sur mesure en ligne.\",\n  },\n  {\n    id: \"p_init_2\",\n    name: \"Menuiserie Aquitaine Cr\303\251ation\",\n    activity: \"Artisan \303\211b\303\251niste Menuisier\",\n    location: \"M\303\251rignac / Bordeaux\",\n    phone: \"05 56 90 31 10\",\n    website: \"http://menuiserie-aquitaine-creation.fr\",\n    email: \"direction@menuiserie-aquitaine.com\",\n    rating: 4.8,\n    reviewCount: 38,\n    status: \"to_contact\",\n    relevanceScore: 9,\n    keyAngle: \"Site ancien non adapt\303\251 aux smartphones, photos de r\303\251alisations compress\303\251es et formulaire de demande de devis non fonctionnel.\",\n  },\n  {\n    id: \"p_init_3\",\n    name: \"Cabinet Ost\303\251opathie & Bien-\303\252tre\",\n    activity: \"Ost\303\251opathe D.O.\",\n    location: \"Bordeaux Chartrons\",\n    phone: \"06 72 10 44 92\",\n    website: \"https://cabinet-chartrons-osteo.fr\",\n    email: \"contact@cabinet-chartrons-osteo.fr\",\n    rating: 4.9,\n    reviewCount: 65,\n    status: \"contacted\",\n    relevanceScore: 8,\n    keyAngle: \"Tr\303\250s bonne r\303\251putation de quartier mais visibilit\303\251 Google Maps en 4e position derri\303\250re des cabinets moins bien not\303\251s.\",\n    generatedEmail: {\n      subject: \"Piste rapide pour la visibilit\303\251 de votre cabinet aux Chartrons\",\n      body: \"Bonjour,\\n\\nEn observant les praticiens aux Chartrons, j\'ai remarqu\303\251 l\'excellente r\303\251putation de votre cabinet (4.9/5 avec plus de 60 avis).\\n\\nCependant, sur les requ\303\252tes \'ost\303\251opathe bordeaux chartrons\', votre fiche appara\303\256t derri\303\250re des confr\303\250res avec moins d\'avis r\303\251cents. Quelques ajustements simples sur votre site et vos m\303\251tadonn\303\251es permettraient de vous placer directement dans le Top 3 Google Maps.\\n\\nSeriez-vous ouvert \303\240 un \303\251change informel de 10 minutes cette semaine ? Je vous partagerais volontiers deux actions imm\303\251diates \303\240 appliquer.\\n\\nBien cordialement,\",\n      generatedAt: \"2026-09-18T10:00:00.000Z\",\n    },\n  },\n];\n\nexport default function App() {\n  const [prospects, setProspects] = useState<Prospect[]>(() => {\n    const saved = localStorage.getItem(\"freelance_prospects\");\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch {\n        return INITIAL_PROSPECTS;\n      }\n    }\n    return INITIAL_PROSPECTS;\n  });\n\n  const [freelanceProfile, setFreelanceProfile] = useState<FreelanceProfile>(() => {\n    const saved = localStorage.getItem(\"freelance_profile\");\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch {\n        return INITIAL_PROFILE;\n      }\n    }\n    return INITIAL_PROFILE;\n  });\n\n  const [gmailToken, setGmailToken] = useState<string | null>(() => {\n    return sessionStorage.getItem(\"gmail_access_token\") || null;\n  });\n\n  const [userEmail, setUserEmail] = useState<string | null>(() => {\n    return sessionStorage.getItem(\"gmail_user_email\") || \"maxime.elhaik@gmail.com\";\n  });\n\n  const [selectedProspect, setSelectedProspect] = useState<Prospect | null>(null);\n  const [searchLoading, setSearchLoading] = useState(false);\n  const [filterStatus, setFilterStatus] = useState(\"all\");\n\n  useEffect(() => {\n    localStorage.setItem(\"freelance_prospects\", JSON.stringify(prospects));\n  }, [prospects]);\n\n  useEffect(() => {\n    localStorage.setItem(\"freelance_profile\", JSON.stringify(freelanceProfile));\n  }, [freelanceProfile]);\n\n  const handleTokenChange = (token: string | null, email?: string) => {\n    setGmailToken(token);\n    if (token) {\n      sessionStorage.setItem(\"gmail_access_token\", token);\n      if (email) {\n        setUserEmail(email);\n        sessionStorage.setItem(\"gmail_user_email\", email);\n      }\n    } else {\n      sessionStorage.removeItem(\"gmail_access_token\");\n      sessionStorage.removeItem(\"gmail_user_email\");\n      setUserEmail(null);\n    }\n  };\n\n  const handleSearch = async (query: SearchQuery) => {\n    setSearchLoading(true);\n    try {\n      const res = await fetch(\"/api/prospects/search\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          sector: query.sector,\n          city: query.city,\n          specialty: query.specialty,\n          freelanceProfile,\n        }),\n      });\n\n      if (!res.ok) {\n        throw new Error(\"Erreur de r\303\251cup\303\251ration des prospects\");\n      }\n\n      const data = await res.json();\n      if (data.prospects && Array.isArray(data.prospects)) {\n        // Prepend new prospects to list, avoiding exact duplicates by name\n        setProspects((prev) => {\n          const existingNames = new Set(prev.map((p) => p.name.toLowerCase()));\n          const newUnique = data.prospects.filter(\n            (p: Prospect) => !existingNames.has(p.name.toLowerCase())\n          );\n          return [...newUnique, ...prev];\n        });\n      }\n    } catch (err) {\n      console.error(\"Search failed\", err);\n    } finally {\n      setSearchLoading(false);\n    }\n  };\n\n  const handleUpdateProspect = (updated: Prospect) => {\n    setProspects((prev) => prev.map((p) => (p.id === updated.id ? updated : p)));\n    setSelectedProspect(updated);\n  };\n\n  const handleUpdateStatus = (id: string, status: Prospect[\"status\"]) => {\n    setProspects((prev) => prev.map((p) => (p.id === id ? { ...p, status } : p)));\n  };\n\n  const handleDeleteProspect = (id: string) => {\n    setProspects((prev) => prev.filter((p) => p.id !== id));\n    if (selectedProspect?.id === id) {\n      setSelectedProspect(null);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-zinc-100 text-zinc-900 font-sans antialiased flex flex-col\">\n      {/* Top Bar Header */}\n      <header className=\"border-b border-zinc-200/80 bg-white/90 backdrop-blur-xs sticky top-0 z-30\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-zinc-900 text-white flex items-center justify-center font-bold text-sm shadow-xs\">\n              P\n            </div>\n            <div>\n              <h1 className=\"text-sm font-semibold text-zinc-900 leading-tight\">\n                Prospection Locale Freelance\n              </h1>\n              <p className=\"text-[11px] text-zinc-500\">\n                Sourcing local cern\303\251 et emails personnalis\303\251s par IA\n              </p>\n            </div>\n          </div>\n\n          <div className=\"w-full sm:w-auto min-w-[280px]\">\n            <GmailAuth\n              token={gmailToken}\n              onTokenChange={handleTokenChange}\n              userEmail={userEmail}\n            />\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container - Responsive Bento Grid */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-5\">\n        {/* Bento Row 1: KPI Stats */}\n        <StatsBento prospects={prospects} />\n\n        {/* Bento Row 2: Search + Actionable Prospects Dashboard */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5 items-start\">\n          {/* Left Column: Sourcing Panel (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-4\">\n            <SearchPanel\n              onSearch={handleSearch}\n              loading={searchLoading}\n              freelanceProfile={freelanceProfile}\n              onUpdateProfile={setFreelanceProfile}\n            />\n\n            {/* Quick Helper / Process Card */}\n            <div className=\"bg-white border border-zinc-200 rounded-2xl p-4 shadow-xs text-xs space-y-2.5\">\n              <span className=\"font-semibold text-zinc-900 block\">\n                Workflow de prospection\n              </span>\n              <div className=\"space-y-2 text-zinc-600\">\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5\">\n                    1\n                  </span>\n                  <span>D\303\251tectez des cibles locales avec Google Search & Maps.</span>\n                </div>\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5\">\n                    2\n                  </span>\n                  <span>S\303\251lectionnez un prospect et g\303\251n\303\251rez un email ultra-cibl\303\251.</span>\n                </div>\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5\">\n                    3\n                  </span>\n                  <span>Envoyez directement via Gmail ou cr\303\251ez un brouillon.</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Prospects List (8 cols) */}\n          <div className=\"lg:col-span-8\">\n            <ProspectList\n              prospects={prospects}\n              onSelectProspect={(p) => setSelectedProspect(p)}\n              onUpdateStatus={handleUpdateStatus}\n              onDeleteProspect={handleDeleteProspect}\n              selectedId={selectedProspect?.id || null}\n              filterStatus={filterStatus}\n              onFilterChange={setFilterStatus}\n            />\n          </div>\n        </div>\n      </main>\n\n      {/* Prospect Detail & Email Customizer Modal */}\n      {selectedProspect && (\n        <ProspectDetailModal\n          prospect={selectedProspect}\n          onClose={() => setSelectedProspect(null)}\n          freelanceProfile={freelanceProfile}\n          onUpdateProspect={handleUpdateProspect}\n          gmailToken={gmailToken}\n        />\n      )}\n    </div>\n  );\n}\n"
    raw_content: "import React, { useState, useEffect } from \"react\";\nimport { \n  Building2, \n  MapPin, \n  Send, \n  Sparkles, \n  Mail, \n  CheckCircle2, \n  Search, \n  Plus, \n  Filter, \n  RefreshCw,\n  SlidersHorizontal,\n  ChevronDown\n} from \"lucide-react\";\nimport { motion } from \"motion/react\";\nimport { Prospect, FreelanceProfile, SearchQuery } from \"./types\";\nimport { StatsBento } from \"./components/StatsBento\";\nimport { SearchPanel } from \"./components/SearchPanel\";\nimport { ProspectList } from \"./components/ProspectList\";\nimport { ProspectDetailModal } from \"./components/ProspectDetailModal\";\nimport { GmailAuth } from \"./components/GmailAuth\";\n\nconst INITIAL_PROFILE: FreelanceProfile = {\n  title: \"Freelance Web & Visibilit\303\251 Locale\",\n  services: \"Refonte de site moderne, SEO Google Maps, optimisation conversion, devis en ligne\",\n  targetSector: \"Commerces & Artisans\",\n  targetCity: \"Bordeaux\",\n  valueProposition: \"Aider les acteurs locaux \303\240 transformer leurs visiteurs en clients et moderniser leur image.\",\n};\n\nconst INITIAL_PROSPECTS: Prospect[] = [\n  {\n    id: \"p_init_1\",\n    name: \"Boulangerie L\'\303\211pi Dor\303\251\",\n    activity: \"Boulangerie P\303\242tisserie Artisanale\",\n    location: \"Bordeaux Centre (Saint-Pierre)\",\n    phone: \"05 56 44 12 89\",\n    website: \"\",\n    email: \"contact@lepidore-bordeaux.fr\",\n    rating: 4.6,\n    reviewCount: 124,\n    status: \"to_contact\",\n    relevanceScore: 9,\n    keyAngle: \"Forte affluence locale et tr\303\250s bonnes notes, mais absence de site web et pas de syst\303\250me de commande ou g\303\242teaux sur mesure en ligne.\",\n  },\n  {\n    id: \"p_init_2\",\n    name: \"Menuiserie Aquitaine Cr\303\251ation\",\n    activity: \"Artisan \303\211b\303\251niste Menuisier\",\n    location: \"M\303\251rignac / Bordeaux\",\n    phone: \"05 56 90 31 10\",\n    website: \"http://menuiserie-aquitaine-creation.fr\",\n    email: \"direction@menuiserie-aquitaine.com\",\n    rating: 4.8,\n    reviewCount: 38,\n    status: \"to_contact\",\n    relevanceScore: 9,\n    keyAngle: \"Site ancien non adapt\303\251 aux smartphones, photos de r\303\251alisations compress\303\251es et formulaire de demande de devis non fonctionnel.\",\n  },\n  {\n    id: \"p_init_3\",\n    name: \"Cabinet Ost\303\251opathie & Bien-\303\252tre\",\n    activity: \"Ost\303\251opathe D.O.\",\n    location: \"Bordeaux Chartrons\",\n    phone: \"06 72 10 44 92\",\n    website: \"https://cabinet-chartrons-osteo.fr\",\n    email: \"contact@cabinet-chartrons-osteo.fr\",\n    rating: 4.9,\n    reviewCount: 65,\n    status: \"contacted\",\n    relevanceScore: 8,\n    keyAngle: \"Tr\303\250s bonne r\303\251putation de quartier mais visibilit\303\251 Google Maps en 4e position derri\303\250re des cabinets moins bien not\303\251s.\",\n    generatedEmail: {\n      subject: \"Piste rapide pour la visibilit\303\251 de votre cabinet aux Chartrons\",\n      body: \"Bonjour,\\n\\nEn observant les praticiens aux Chartrons, j\'ai remarqu\303\251 l\'excellente r\303\251putation de votre cabinet (4.9/5 avec plus de 60 avis).\\n\\nCependant, sur les requ\303\252tes \'ost\303\251opathe bordeaux chartrons\', votre fiche appara\303\256t derri\303\250re des confr\303\250res avec moins d\'avis r\303\251cents. Quelques ajustements simples sur votre site et vos m\303\251tadonn\303\251es permettraient de vous placer directement dans le Top 3 Google Maps.\\n\\nSeriez-vous ouvert \303\240 un \303\251change informel de 10 minutes cette semaine ? Je vous partagerais volontiers deux actions imm\303\251diates \303\240 appliquer.\\n\\nBien cordialement,\",\n      generatedAt: \"2026-09-18T10:00:00.000Z\",\n    },\n  },\n];\n\nexport default function App() {\n  const [prospects, setProspects] = useState<Prospect[]>(() => {\n    const saved = localStorage.getItem(\"freelance_prospects\");\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch {\n        return INITIAL_PROSPECTS;\n      }\n    }\n    return INITIAL_PROSPECTS;\n  });\n\n  const [freelanceProfile, setFreelanceProfile] = useState<FreelanceProfile>(() => {\n    const saved = localStorage.getItem(\"freelance_profile\");\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch {\n        return INITIAL_PROFILE;\n      }\n    }\n    return INITIAL_PROFILE;\n  });\n\n  const [gmailToken, setGmailToken] = useState<string | null>(() => {\n    return sessionStorage.getItem(\"gmail_access_token\") || null;\n  });\n\n  const [userEmail, setUserEmail] = useState<string | null>(() => {\n    return sessionStorage.getItem(\"gmail_user_email\") || \"maxime.elhaik@gmail.com\";\n  });\n\n  const [selectedProspect, setSelectedProspect] = useState<Prospect | null>(null);\n  const [searchLoading, setSearchLoading] = useState(false);\n  const [filterStatus, setFilterStatus] = useState(\"all\");\n\n  useEffect(() => {\n    localStorage.setItem(\"freelance_prospects\", JSON.stringify(prospects));\n  }, [prospects]);\n\n  useEffect(() => {\n    localStorage.setItem(\"freelance_profile\", JSON.stringify(freelanceProfile));\n  }, [freelanceProfile]);\n\n  const handleTokenChange = (token: string | null, email?: string) => {\n    setGmailToken(token);\n    if (token) {\n      sessionStorage.setItem(\"gmail_access_token\", token);\n      if (email) {\n        setUserEmail(email);\n        sessionStorage.setItem(\"gmail_user_email\", email);\n      }\n    } else {\n      sessionStorage.removeItem(\"gmail_access_token\");\n      sessionStorage.removeItem(\"gmail_user_email\");\n      setUserEmail(null);\n    }\n  };\n\n  const handleSearch = async (query: SearchQuery) => {\n    setSearchLoading(true);\n    try {\n      const res = await fetch(\"/api/prospects/search\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          sector: query.sector,\n          city: query.city,\n          specialty: query.specialty,\n          freelanceProfile,\n        }),\n      });\n\n      if (!res.ok) {\n        throw new Error(\"Erreur de r\303\251cup\303\251ration des prospects\");\n      }\n\n      const data = await res.json();\n      if (data.prospects && Array.isArray(data.prospects)) {\n        // Prepend new prospects to list, avoiding exact duplicates by name\n        setProspects((prev) => {\n          const existingNames = new Set(prev.map((p) => p.name.toLowerCase()));\n          const newUnique = data.prospects.filter(\n            (p: Prospect) => !existingNames.has(p.name.toLowerCase())\n          );\n          return [...newUnique, ...prev];\n        });\n      }\n    } catch (err) {\n      console.error(\"Search failed\", err);\n    } finally {\n      setSearchLoading(false);\n    }\n  };\n\n  const handleUpdateProspect = (updated: Prospect) => {\n    setProspects((prev) => prev.map((p) => (p.id === updated.id ? updated : p)));\n    setSelectedProspect(updated);\n  };\n\n  const handleUpdateStatus = (id: string, status: Prospect[\"status\"]) => {\n    setProspects((prev) => prev.map((p) => (p.id === id ? { ...p, status } : p)));\n  };\n\n  const handleDeleteProspect = (id: string) => {\n    setProspects((prev) => prev.filter((p) => p.id !== id));\n    if (selectedProspect?.id === id) {\n      setSelectedProspect(null);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-zinc-100 text-zinc-900 font-sans antialiased flex flex-col\">\n      {/* Top Bar Header */}\n      <header className=\"border-b border-zinc-200/80 bg-white/90 backdrop-blur-xs sticky top-0 z-30\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-zinc-900 text-white flex items-center justify-center font-bold text-sm shadow-xs\">\n              P\n            </div>\n            <div>\n              <h1 className=\"text-sm font-semibold text-zinc-900 leading-tight\">\n                Prospection Locale Freelance\n              </h1>\n              <p className=\"text-[11px] text-zinc-500\">\n                Sourcing local cern\303\251 et emails personnalis\303\251s par IA\n              </p>\n            </div>\n          </div>\n\n          <div className=\"w-full sm:w-auto min-w-[280px]\">\n            <GmailAuth\n              token={gmailToken}\n              onTokenChange={handleTokenChange}\n              userEmail={userEmail}\n            />\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container - Responsive Bento Grid */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-5\">\n        {/* Bento Row 1: KPI Stats */}\n        <StatsBento prospects={prospects} />\n\n        {/* Bento Row 2: Search + Actionable Prospects Dashboard */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5 items-start\">\n          {/* Left Column: Sourcing Panel (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-4\">\n            <SearchPanel\n              onSearch={handleSearch}\n              loading={searchLoading}\n              freelanceProfile={freelanceProfile}\n              onUpdateProfile={setFreelanceProfile}\n            />\n\n            {/* Quick Helper / Process Card */}\n            <div className=\"bg-white border border-zinc-200 rounded-2xl p-4 shadow-xs text-xs space-y-2.5\">\n              <span className=\"font-semibold text-zinc-900 block\">\n                Workflow de prospection\n              </span>\n              <div className=\"space-y-2 text-zinc-600\">\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5\">\n                    1\n                  </span>\n                  <span>D\303\251tectez des cibles locales avec Google Search & Maps.</span>\n                </div>\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5\">\n                    2\n                  </span>\n                  <span>S\303\251lectionnez un prospect et g\303\251n\303\251rez un email ultra-cibl\303\251.</span>\n                </div>\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5\">\n                    3\n                  </span>\n                  <span>Envoyez directement via Gmail ou cr\303\251ez un brouillon.</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Prospects List (8 cols) */}\n          <div className=\"lg:col-span-8\">\n            <ProspectList\n              prospects={prospects}\n              onSelectProspect={(p) => setSelectedProspect(p)}\n              onUpdateStatus={handleUpdateStatus}\n              onDeleteProspect={handleDeleteProspect}\n              selectedId={selectedProspect?.id || null}\n              filterStatus={filterStatus}\n              onFilterChange={setFilterStatus}\n            />\n          </div>\n        </div>\n      </main>\n\n      {/* Prospect Detail & Email Customizer Modal */}\n      {selectedProspect && (\n        <ProspectDetailModal\n          prospect={selectedProspect}\n          onClose={() => setSelectedProspect(null)}\n          freelanceProfile={freelanceProfile}\n          onUpdateProspect={handleUpdateProspect}\n          gmailToken={gmailToken}\n        />\n      )}\n    </div>\n  );\n}\n"
