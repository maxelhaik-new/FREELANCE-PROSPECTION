    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Mail, CheckCircle2, AlertCircle, LogOut, RefreshCw } from \"lucide-react\";\nimport { googleSignIn, logout, initAuth } from \"../lib/firebase\";\n\ninterface GmailAuthProps {\n  token: string | null;\n  onTokenChange: (token: string | null, email?: string) => void;\n  userEmail: string | null;\n}\n\nexport const GmailAuth: React.FC<GmailAuthProps> = ({\n  token,\n  onTokenChange,\n  userEmail,\n}) => {\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    const unsubscribe = initAuth(\n      (user, cachedToken) => {\n        onTokenChange(cachedToken, user.email || undefined);\n      },\n      () => {\n        // Not logged in or logged out\n      }\n    );\n    return () => unsubscribe();\n  }, [onTokenChange]);\n\n  const handleConnect = async () => {\n    setError(null);\n    setLoading(true);\n\n    try {\n      const result = await googleSignIn();\n      if (result?.accessToken) {\n        onTokenChange(result.accessToken, result.user.email || undefined);\n      }\n    } catch (err: any) {\n      console.error(\"Erreur OAuth:\", err);\n      setError(err.message || \"Erreur d\'authentification Google OAuth\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDisconnect = async () => {\n    try {\n      await logout();\n      onTokenChange(null);\n    } catch (err: any) {\n      console.error(\"Erreur d\303\251connexion:\", err);\n      onTokenChange(null);\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col gap-1 p-3 bg-zinc-50 border border-zinc-200 rounded-xl text-xs\">\n      <div className=\"flex items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-2 min-w-0\">\n          <div className={`p-1.5 rounded-lg ${token ? \'bg-emerald-100 text-emerald-700\' : \'bg-zinc-200 text-zinc-600\'}`}>\n            <Mail className=\"w-4 h-4\" />\n          </div>\n          <div className=\"truncate\">\n            <div className=\"font-medium text-zinc-900 truncate\">\n              {token ? (userEmail || \"Compte Gmail connect\303\251\") : \"Connexion Gmail\"}\n            </div>\n            <div className=\"text-zinc-500 truncate\">\n              {token ? \"Envoi direct et brouillons pr\303\252ts\" : \"Pour envoyer directement vos mails\"}\n            </div>\n          </div>\n        </div>\n\n        <div>\n          {token ? (\n            <button\n              id=\"disconnect-gmail-btn\"\n              onClick={handleDisconnect}\n              className=\"px-2.5 py-1 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-200/60 rounded-md transition-colors flex items-center gap-1 font-medium\"\n              title=\"D\303\251connecter\"\n            >\n              <LogOut className=\"w-3.5 h-3.5\" />\n              <span>D\303\251connexion</span>\n            </button>\n          ) : (\n            <button\n              id=\"connect-gmail-btn\"\n              onClick={handleConnect}\n              disabled={loading}\n              className=\"px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg transition-colors font-medium flex items-center gap-1.5 disabled:opacity-50\"\n            >\n              {loading ? (\n                <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n              ) : (\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n              )}\n              <span>Connecter</span>\n            </button>\n          )}\n        </div>\n      </div>\n\n      {error && (\n        <div className=\"text-rose-600 text-[11px] flex items-center gap-1 mt-1 pt-1 border-t border-rose-100\">\n          <AlertCircle className=\"w-3 h-3 shrink-0\" />\n          <span className=\"truncate\">{error}</span>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 145
      unified_diff {
        lines {
          text: "import React, { useState, useEffect } from \"react\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
