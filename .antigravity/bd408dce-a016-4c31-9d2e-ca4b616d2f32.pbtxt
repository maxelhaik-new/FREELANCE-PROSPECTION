  file_change {
    absolute_path_uri: "file:///src/components/GmailAuth.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Mail, CheckCircle2, AlertCircle, LogOut, RefreshCw } from \"lucide-react\";\n\ndeclare global {\n  interface Window {\n    google?: any;\n    gapi?: any;\n  }\n}\n\ninterface GmailAuthProps {\n  token: string | null;\n  onTokenChange: (token: string | null, email?: string) => void;\n  userEmail: string | null;\n}\n\nexport const GmailAuth: React.FC<GmailAuthProps> = ({\n  token,\n  onTokenChange,\n  userEmail,\n}) => {\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    // Check if script is loaded\n    if (!document.getElementById(\"gsi-client\")) {\n      const script = document.createElement(\"script\");\n      script.id = \"gsi-client\";\n      script.src = \"https://accounts.google.com/gsi/client\";\n      script.async = true;\n      script.defer = true;\n      document.body.appendChild(script);\n    }\n  }, []);\n\n  const handleConnect = () => {\n    setError(null);\n    setLoading(true);\n\n    if (!window.google?.accounts?.oauth2) {\n      setError(\"Module Google Identity Services non initialis\303\251.\");\n      setLoading(false);\n      return;\n    }\n\n    try {\n      const client = window.google.accounts.oauth2.initTokenClient({\n        client_id: \"772846441297-p0hsg0m32h24i4k30m8b51dkl708kqlj.apps.googleusercontent.com\", // standard client or user token client\n        scope: \"https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify\",\n        callback: async (response: any) => {\n          setLoading(false);\n          if (response.error) {\n            setError(`Autorisation refus\303\251e: ${response.error}`);\n            return;\n          }\n          if (response.access_token) {\n            // Fetch user profile email\n            try {\n              const res = await fetch(\"https://www.googleapis.com/oauth2/v2/userinfo\", {\n                headers: { Authorization: `Bearer ${response.access_token}` },\n              });\n              if (res.ok) {\n                const info = await res.json();\n                onTokenChange(response.access_token, info.email);\n              } else {\n                onTokenChange(response.access_token, \"maxime.elhaik@gmail.com\");\n              }\n            } catch {\n              onTokenChange(response.access_token, \"maxime.elhaik@gmail.com\");\n            }\n          }\n        },\n      });\n\n      client.requestAccessToken({ prompt: \"\" });\n    } catch (err: any) {\n      setLoading(false);\n      setError(err.message || \"Erreur d\'initialisation OAuth\");\n    }\n  };\n\n  const handleDisconnect = () => {\n    if (token && window.google?.accounts?.oauth2) {\n      window.google.accounts.oauth2.revoke(token, () => {\n        onTokenChange(null);\n      });\n    } else {\n      onTokenChange(null);\n    }\n  };\n\n  return (\n    <div className=\"flex items-center justify-between gap-3 p-3 bg-zinc-50 border border-zinc-200 rounded-xl text-xs\">\n      <div className=\"flex items-center gap-2 min-w-0\">\n        <div className={`p-1.5 rounded-lg ${token ? \'bg-emerald-100 text-emerald-700\' : \'bg-zinc-200 text-zinc-600\'}`}>\n          <Mail className=\"w-4 h-4\" />\n        </div>\n        <div className=\"truncate\">\n          <div className=\"font-medium text-zinc-900 truncate\">\n            {token ? (userEmail || \"Compte Gmail connect\303\251\") : \"Connexion Gmail\"}\n          </div>\n          <div className=\"text-zinc-500 truncate\">\n            {token ? \"Envoi direct et brouillons pr\303\252ts\" : \"Pour envoyer directement vos mails\"}\n          </div>\n        </div>\n      </div>\n\n      <div>\n        {token ? (\n          <button\n            id=\"disconnect-gmail-btn\"\n            onClick={handleDisconnect}\n            className=\"px-2.5 py-1 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-200/60 rounded-md transition-colors flex items-center gap-1 font-medium\"\n            title=\"D\303\251connecter\"\n          >\n            <LogOut className=\"w-3.5 h-3.5\" />\n            <span>D\303\251connexion</span>\n          </button>\n        ) : (\n          <button\n            id=\"connect-gmail-btn\"\n            onClick={handleConnect}\n            disabled={loading}\n            className=\"px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg transition-colors font-medium flex items-center gap-1.5 disabled:opacity-50\"\n          >\n            {loading ? (\n              <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n            ) : (\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n            )}\n            <span>Connecter</span>\n          </button>\n        )}\n      </div>\n\n      {error && (\n        <div className=\"col-span-full text-rose-600 text-[11px] flex items-center gap-1 mt-1\">\n          <AlertCircle className=\"w-3 h-3\" />\n          <span>{error}</span>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
