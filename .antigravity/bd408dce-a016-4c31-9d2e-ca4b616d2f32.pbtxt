  file_change {
    absolute_path_uri: "file:///src/components/GoogleMapView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef, useState } from \"react\";\nimport { MapPin, Navigation, ExternalLink, Star, Compass, Layers } from \"lucide-react\";\nimport { Prospect } from \"../types\";\n\ndeclare global {\n  interface Window {\n    google?: any;\n    initGoogleMapCallback?: () => void;\n  }\n}\n\ninterface GoogleMapViewProps {\n  prospects: Prospect[];\n  selectedProspect: Prospect | null;\n  onSelectProspect: (prospect: Prospect) => void;\n  targetCity: string;\n  searchSector?: string;\n}\n\n// Fallback approximate coordinates for major French cities if not geocoded\nconst CITY_COORDINATES: Record<string, { lat: number; lng: number }> = {\n  bordeaux: { lat: 44.8378, lng: -0.5792 },\n  paris: { lat: 48.8566, lng: 2.3522 },\n  lyon: { lat: 45.7640, lng: 4.8357 },\n  marseille: { lat: 43.2965, lng: 5.3698 },\n  toulouse: { lat: 43.6047, lng: 1.4442 },\n  nice: { lat: 43.7102, lng: 7.2620 },\n  nantes: { lat: 47.2184, lng: -1.5536 },\n  strasbourg: { lat: 48.5734, lng: 7.7521 },\n  montpellier: { lat: 43.6108, lng: 3.8767 },\n  lille: { lat: 50.6292, lng: 3.0573 },\n  rennes: { lat: 48.1173, lng: -1.6778 },\n  rouen: { lat: 49.4432, lng: 1.0999 },\n};\n\nexport const GoogleMapView: React.FC<GoogleMapViewProps> = ({\n  prospects,\n  selectedProspect,\n  onSelectProspect,\n  targetCity,\n  searchSector,\n}) => {\n  const mapContainerRef = useRef<HTMLDivElement>(null);\n  const mapInstanceRef = useRef<any>(null);\n  const markersMapRef = useRef<Map<string, { marker: any; position: any; infoWindow: any }>>(new Map());\n  const [mapLoaded, setMapLoaded] = useState(false);\n  const [loadError, setLoadError] = useState<string | null>(null);\n\n  const apiKey =\n    import.meta.env.VITE_GOOGLE_MAPS_API_KEY ||\n    \"AIzaSyCGd-2iS0OSp9WG-dD5k_TYPLE2h3shJjI\";\n\n  useEffect(() => {\n    let isMounted = true;\n\n    const loadGoogleMapsScript = () => {\n      if (window.google?.maps) {\n        if (isMounted) setMapLoaded(true);\n        return;\n      }\n\n      const existingScript = document.getElementById(\"google-maps-sdk\");\n      if (!existingScript) {\n        const script = document.createElement(\"script\");\n        script.id = \"google-maps-sdk\";\n        script.src = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&libraries=places`;\n        script.async = true;\n        script.defer = true;\n        script.onload = () => {\n          if (isMounted) setMapLoaded(true);\n        };\n        script.onerror = () => {\n          if (isMounted) setLoadError(\"Impossible de charger l\'API Google Maps\");\n        };\n        document.head.appendChild(script);\n      } else {\n        existingScript.addEventListener(\"load\", () => {\n          if (isMounted) setMapLoaded(true);\n        });\n      }\n    };\n\n    loadGoogleMapsScript();\n\n    return () => {\n      isMounted = false;\n    };\n  }, [apiKey]);\n\n  // Determine center coordinates\n  const getCityCenter = (): { lat: number; lng: number } => {\n    const normalizedCity = (targetCity || \"\").trim().toLowerCase();\n    for (const [key, coords] of Object.entries(CITY_COORDINATES)) {\n      if (normalizedCity.includes(key)) {\n        return coords;\n      }\n    }\n    // Check if any prospect has coordinates\n    const withCoords = prospects.find((p) => p.lat && p.lng);\n    if (withCoords?.lat && withCoords?.lng) {\n      return { lat: withCoords.lat, lng: withCoords.lng };\n    }\n    return { lat: 44.8378, lng: -0.5792 }; // Default Bordeaux\n  };\n\n  // Initialize Map\n  useEffect(() => {\n    if (!mapLoaded || !mapContainerRef.current || !window.google?.maps) return;\n\n    if (!mapInstanceRef.current) {\n      const center = getCityCenter();\n      const mapOptions = {\n        center,\n        zoom: 13,\n        mapId: \"DEMO_MAP_ID\",\n        disableDefaultUI: false,\n        zoomControl: true,\n        streetViewControl: false,\n        mapTypeControl: false,\n        fullscreenControl: true,\n        styles: [\n          {\n            featureType: \"poi.business\",\n            stylers: [{ visibility: \"simplified\" }],\n          },\n        ],\n      };\n\n      mapInstanceRef.current = new window.google.maps.Map(\n        mapContainerRef.current,\n        mapOptions\n      );\n    }\n  }, [mapLoaded]);\n\n  // Populate or Update Markers\n  useEffect(() => {\n    if (!mapLoaded || !mapInstanceRef.current || !window.google?.maps) return;\n\n    // Clear previous markers\n    markersMapRef.current.forEach(({ marker }) => marker.setMap(null));\n    markersMapRef.current.clear();\n\n    const bounds = new window.google.maps.LatLngBounds();\n    let hasValidBounds = false;\n    const center = getCityCenter();\n\n    prospects.forEach((prospect, idx) => {\n      let lat = prospect.lat;\n      let lng = prospect.lng;\n\n      if (!lat || !lng) {\n        const angle = (idx * 2 * Math.PI) / (prospects.length || 1);\n        const radius = 0.012 + (idx % 3) * 0.006;\n        lat = center.lat + radius * Math.cos(angle);\n        lng = center.lng + radius * Math.sin(angle);\n      }\n\n      const position = new window.google.maps.LatLng(lat, lng);\n      bounds.extend(position);\n      hasValidBounds = true;\n\n      const isSelected = selectedProspect?.id === prospect.id;\n      const isIdentified = prospect.identified;\n\n      const marker = new window.google.maps.Marker({\n        position,\n        map: mapInstanceRef.current,\n        title: prospect.name,\n        animation: isSelected ? window.google.maps.Animation.BOUNCE : null,\n        icon: {\n          path: window.google.maps.SymbolPath.CIRCLE,\n          scale: isSelected ? 12 : isIdentified ? 9 : 7,\n          fillColor: isSelected ? \"#18181b\" : isIdentified ? \"#10b981\" : \"#3b82f6\",\n          fillOpacity: 1,\n          strokeColor: \"#ffffff\",\n          strokeWeight: isSelected ? 3 : 2,\n        },\n        zIndex: isSelected ? 999 : isIdentified ? 50 : 1,\n      });\n\n      const infoContent = `\n        <div style=\"padding: 6px; font-family: sans-serif; font-size: 12px; max-width: 230px;\">\n          <div style=\"font-weight: 600; font-size: 13px; color: #18181b; margin-bottom: 2px;\">\n            ${prospect.name}\n          </div>\n          <div style=\"color: #71717a; font-size: 11px; margin-bottom: 4px;\">\n            ${prospect.activity} \342\200\242 ${prospect.location}\n          </div>\n          ${\n            prospect.rating\n              ? `<div style=\"color: #d97706; font-size: 11px; margin-bottom: 4px;\">\342\230\205 ${prospect.rating} (${prospect.reviewCount || 0} avis)</div>`\n              : \"\"\n          }\n          <div style=\"font-size: 11px; color: #3f3f46; background: #f4f4f5; padding: 5px; border-radius: 4px; margin-top: 4px; line-height: 1.4;\">\n            ${prospect.keyAngle || \"Opportunit\303\251 locale\"}\n          </div>\n        </div>\n      `;\n\n      const infoWindow = new window.google.maps.InfoWindow({\n        content: infoContent,\n      });\n\n      // Marker click puts item in highlight in the list and centers it, without opening the email modal\n      marker.addListener(\"click\", () => {\n        onSelectProspect(prospect);\n        infoWindow.open(mapInstanceRef.current, marker);\n        mapInstanceRef.current.panTo(position);\n        if (mapInstanceRef.current.getZoom() < 14) {\n          mapInstanceRef.current.setZoom(15);\n        }\n      });\n\n      markersMapRef.current.set(prospect.id, { marker, position, infoWindow });\n    });\n\n    // Fit bounds on first load if no prospect is specifically selected\n    if (hasValidBounds && mapInstanceRef.current && prospects.length > 0 && !selectedProspect) {\n      mapInstanceRef.current.fitBounds(bounds);\n      const listener = window.google.maps.event.addListenerOnce(\n        mapInstanceRef.current,\n        \"idle\",\n        () => {\n          if (mapInstanceRef.current.getZoom() > 16) {\n            mapInstanceRef.current.setZoom(15);\n          }\n        }\n      );\n      return () => {\n        window.google.maps.event.removeListener(listener);\n      };\n    }\n  }, [mapLoaded, prospects, targetCity]);\n\n  // Center on prospect when selectedProspect changes\n  useEffect(() => {\n    if (!mapLoaded || !mapInstanceRef.current || !selectedProspect) return;\n\n    const data = markersMapRef.current.get(selectedProspect.id);\n    if (data) {\n      const { marker, position, infoWindow } = data;\n\n      // Update styling to highlighted\n      marker.setIcon({\n        path: window.google.maps.SymbolPath.CIRCLE,\n        scale: 13,\n        fillColor: \"#18181b\",\n        fillOpacity: 1,\n        strokeColor: \"#ffffff\",\n        strokeWeight: 3,\n      });\n      marker.setAnimation(window.google.maps.Animation.BOUNCE);\n      marker.setZIndex(999);\n\n      // Smooth pan to marker\n      mapInstanceRef.current.panTo(position);\n      if (mapInstanceRef.current.getZoom() < 14) {\n        mapInstanceRef.current.setZoom(15);\n      }\n\n      // Open info bubble\n      infoWindow.open(mapInstanceRef.current, marker);\n\n      // Stop bounce animation after 2.5s\n      const timer = setTimeout(() => {\n        marker.setAnimation(null);\n      }, 2500);\n\n      return () => clearTimeout(timer);\n    }\n  }, [selectedProspect, mapLoaded]);\n\n  return (\n    <div className=\"bg-white border border-zinc-200 rounded-2xl p-4 shadow-xs flex flex-col h-full min-h-[380px]\">\n      <div className=\"flex items-center justify-between pb-3 border-b border-zinc-100\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"p-1.5 bg-blue-50 text-blue-600 rounded-lg\">\n            <Compass className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <h2 className=\"text-sm font-semibold text-zinc-900\">\n              Carte de la recherche en cours\n            </h2>\n            <p className=\"text-[11px] text-zinc-500\">\n              {prospects.length} \303\251tablissement{prospects.length > 1 ? \"s\" : \"\"} \303\240 {targetCity}\n              {searchSector ? ` (${searchSector})` : \"\"}\n            </p>\n          </div>\n        </div>\n\n        {/* Legend */}\n        <div className=\"flex items-center gap-3 text-[11px] text-zinc-500\">\n          <span className=\"flex items-center gap-1\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-blue-500 inline-block\" />\n            Trouv\303\251\n          </span>\n          <span className=\"flex items-center gap-1\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block\" />\n            Retenu\n          </span>\n          <span className=\"flex items-center gap-1\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-zinc-900 inline-block ring-2 ring-zinc-300\" />\n            S\303\251lectionn\303\251\n          </span>\n        </div>\n      </div>\n\n      <div className=\"relative flex-1 mt-3 rounded-xl overflow-hidden border border-zinc-100 bg-zinc-50\">\n        <div ref={mapContainerRef} className=\"w-full h-full min-h-[320px]\" />\n\n        {!mapLoaded && !loadError && (\n          <div className=\"absolute inset-0 bg-white/80 backdrop-blur-xs flex items-center justify-center text-xs text-zinc-500 gap-2\">\n            <Layers className=\"w-4 h-4 animate-spin text-zinc-400\" />\n            <span>Chargement de la carte Google Maps...</span>\n          </div>\n        )}\n\n        {loadError && (\n          <div className=\"absolute inset-0 bg-white flex flex-col items-center justify-center text-xs text-zinc-500 p-4 text-center\">\n            <MapPin className=\"w-6 h-6 text-zinc-400 mb-2\" />\n            <span className=\"font-medium text-zinc-800\">{loadError}</span>\n            <span className=\"text-[11px] text-zinc-400 mt-1\">V\303\251rifiez les restrictions d\'origine HTTP de la cl\303\251.</span>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 283
      unified_diff {
