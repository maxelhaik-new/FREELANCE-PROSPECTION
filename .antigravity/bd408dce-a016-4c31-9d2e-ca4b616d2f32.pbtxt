      arguments_json: "{\"Content\":\"import React from \\\"react\\\";\\nimport { \\n  MapPin, \\n  Star, \\n  ChevronRight, \\n  CheckCircle2, \\n  Clock, \\n  HeartHandshake,\\n  Trash2,\\n  Heart\\n} from \\\"lucide-react\\\";\\nimport { motion } from \\\"motion/react\\\";\\nimport { Prospect } from \\\"../types\\\";\\n\\ninterface ProspectListProps {\\n  prospects: Prospect[];\\n  onSelectProspect: (prospect: Prospect) => void;\\n  onUpdateStatus: (id: string, status: Prospect[\\\"status\\\"]) => void;\\n  onToggleIdentified: (id: string) => void;\\n  onDeleteProspect: (id: string) => void;\\n  selectedId: string | null;\\n  filterStatus: string;\\n  onFilterChange: (status: string) => void;\\n}\\n\\nexport const ProspectList: React.FC<ProspectListProps> = ({\\n  prospects,\\n  onSelectProspect,\\n  onUpdateStatus,\\n  onToggleIdentified,\\n  onDeleteProspect,\\n  selectedId,\\n  filterStatus,\\n  onFilterChange,\\n}) => {\\n  const filtered = prospects.filter((p) => {\\n    if (filterStatus === \\\"all\\\") return true;\\n    if (filterStatus === \\\"identified\\\") return p.identified;\\n    return p.status === filterStatus;\\n  });\\n\\n  const getStatusBadge = (status: Prospect[\\\"status\\\"]) => {\\n    switch (status) {\\n      case \\\"contacted\\\":\\n        return (\\n          <span className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200\\\">\\n            <Clock className=\\\"w-3 h-3\\\" />\\n            Contact\303\251\\n          </span>\\n        );\\n      case \\\"interested\\\":\\n        return (\\n          <span className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200\\\">\\n            <HeartHandshake className=\\\"w-3 h-3\\\" />\\n            Int\303\251ress\303\251\\n          </span>\\n        );\\n      case \\\"declined\\\":\\n        return (\\n          <span className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-zinc-100 text-zinc-600 border border-zinc-200\\\">\\n            Sans suite\\n          </span>\\n        );\\n      default:\\n        return (\\n          <span className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200\\\">\\n            \303\200 contacter\\n          </span>\\n        );\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"bg-white border border-zinc-200 rounded-2xl p-5 shadow-xs flex flex-col h-full\\\">\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-4 border-b border-zinc-100\\\">\\n        <div>\\n          <h2 className=\\\"text-sm font-semibold text-zinc-900\\\">\\n            {filterStatus === \\\"identified\\\"\\n              ? \\\"Prospects Identifi\303\251s (Lik\303\251s)\\\"\\n              : filterStatus === \\\"contacted\\\"\\n              ? \\\"Prospects Contact\303\251s\\\"\\n              : filterStatus === \\\"interested\\\"\\n              ? \\\"Prospects Int\303\251ress\303\251s\\\"\\n              : \\\"Tous les prospects scann\303\251s\\\"}\\n          </h2>\\n          <p className=\\\"text-xs text-zinc-500\\\">\\n            {filtered.length} affich\303\251{filtered.length > 1 ? \\\"s\\\" : \\\"\\\"} sur {prospects.length} au total\\n          </p>\\n        </div>\\n\\n        {/* Pipeline Filter Pills */}\\n        <div className=\\\"flex items-center gap-1 overflow-x-auto text-xs py-0.5\\\">\\n          {[\\n            { key: \\\"all\\\", label: \\\"Tous\\\" },\\n            { key: \\\"identified\\\", label: \\\"Identifi\303\251s (Lik\303\251s)\\\" },\\n            { key: \\\"contacted\\\", label: \\\"Contact\303\251s\\\" },\\n            { key: \\\"interested\\\", label: \\\"Int\303\251ress\303\251s\\\" },\\n          ].map((item) => (\\n            <button\\n              key={item.key}\\n              onClick={() => onFilterChange(item.key)}\\n              className={`px-2.5 py-1 rounded-lg font-medium transition-colors text-[11px] whitespace-nowrap ${\\n                filterStatus === item.key\\n                  ? \\\"bg-zinc-900 text-white\\\"\\n                  : \\\"text-zinc-600 hover:bg-zinc-100\\\"\\n              }`}\\n            >\\n              {item.label}\\n            </button>\\n          ))}\\n        </div>\\n      </div>\\n\\n      {/* Prospect cards */}\\n      <div className=\\\"mt-4 space-y-2.5 overflow-y-auto max-h-[580px] pr-1\\\">\\n        {filtered.length === 0 ? (\\n          <div className=\\\"py-12 text-center text-zinc-400 text-xs\\\">\\n            {filterStatus === \\\"identified\\\"\\n              ? \\\"Aucun prospect lik\303\251. Cliquez sur le c\305\223ur pour identifier et retenir vos cibles.\\\"\\n              : \\\"Aucun prospect ne correspond \303\240 ce filtre.\\\"}\\n          </div>\\n        ) : (\\n          filtered.map((prospect) => (\\n            <motion.div\\n              key={prospect.id}\\n              layout\\n              initial={{ opacity: 0, y: 4 }}\\n              animate={{ opacity: 1, y: 0 }}\\n              transition={{ duration: 0.15 }}\\n              className={`group p-3.5 rounded-xl border transition-all cursor-pointer ${\\n                selectedId === prospect.id\\n                  ? \\\"border-zinc-900 bg-zinc-50/70 shadow-xs\\\"\\n                  : \\\"border-zinc-200/90 hover:border-zinc-300 bg-white\\\"\\n              }`}\\n              onClick={() => onSelectProspect(prospect)}\\n            >\\n              <div className=\\\"flex items-start justify-between gap-3\\\">\\n                <div className=\\\"min-w-0 flex-1\\\">\\n                  <div className=\\\"flex items-center gap-2 flex-wrap\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={(e) => {\\n                        e.stopPropagation();\\n                        onToggleIdentified(prospect.id);\\n                      }}\\n                      className={`p-1 rounded-md transition-colors ${\\n                        prospect.identified\\n                          ? \\\"text-emerald-600 bg-emerald-50 hover:bg-emerald-100\\\"\\n                          : \\\"text-zinc-300 hover:text-emerald-600 hover:bg-zinc-100\\\"\\n                      }`}\\n                      title={prospect.identified ? \\\"Retirer de la s\303\251lection\\\" : \\\"Liker / Identifier ce prospect\\\"}\\n                    >\\n                      <Heart\\n                        className={`w-4 h-4 ${prospect.identified ? \\\"fill-emerald-600\\\" : \\\"\\\"}`}\\n                      />\\n                    </button>\\n\\n                    <h3 className=\\\"font-semibold text-xs text-zinc-900 truncate\\\">{prospect.name}</h3>\\n                    {getStatusBadge(prospect.status)}\\n                    {prospect.identified && (\\n                      <span className=\\\"text-[10px] px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium\\\">\\n                        Retenu\\n                      </span>\\n                    )}\\n                    {prospect.generatedEmail && (\\n                      <span className=\\\"text-[10px] px-1.5 py-0.5 rounded bg-purple-50 text-purple-700 border border-purple-200\\\">\\n                        Email pr\303\252t\\n                      </span>\\n                    )}\\n                  </div>\\n\\n                  <div className=\\\"flex items-center gap-2 mt-1 text-[11px] text-zinc-500 truncate\\\">\\n                    <span className=\\\"truncate\\\">{prospect.activity}</span>\\n                    <span>\342\200\242</span>\\n                    <span className=\\\"flex items-center gap-0.5 shrink-0 text-zinc-400\\\">\\n                      <MapPin className=\\\"w-3 h-3\\\" />\\n                      {prospect.location}\\n                    </span>\\n                    {prospect.rating ? (\\n                      <>\\n                        <span>\342\200\242</span>\\n                        <span className=\\\"flex items-center gap-0.5 text-amber-600 shrink-0\\\">\\n                          <Star className=\\\"w-3 h-3 fill-amber-400 text-amber-400\\\" />\\n                          {prospect.rating}\\n                        </span>\\n                      </>\\n                    ) : null}\\n                  </div>\\n\\n                  {/* Key Opportunity Angle */}\\n                  <p className=\\\"text-[11px] text-zinc-600 mt-2 line-clamp-2 bg-zinc-50 p-2 rounded-lg border border-zinc-100\\\">\\n                    <span className=\\\"font-medium text-zinc-700\\\">Angle :</span> {prospect.keyAngle}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"flex flex-col items-end gap-2 shrink-0\\\">\\n                  <button\\n                    onClick={(e) => {\\n                      e.stopPropagation();\\n                      onSelectProspect(prospect);\\n                    }}\\n                    className=\\\"p-1.5 rounded-lg text-zinc-400 group-hover:text-zinc-900 hover:bg-zinc-100 transition-colors\\\"\\n                    title=\\\"Ouvrir et r\303\251diger le mail\\\"\\n                  >\\n                    <ChevronRight className=\\\"w-4 h-4\\\" />\\n                  </button>\\n\\n                  <div className=\\\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\\\">\\n                    <button\\n                      onClick={(e) => {\\n                        e.stopPropagation();\\n                        onUpdateStatus(\\n                          prospect.id,\\n                          prospect.status === \\\"interested\\\" ? \\\"contacted\\\" : \\\"interested\\\"\\n                        );\\n                      }}\\n                      className=\\\"p-1 rounded text-zinc-400 hover:text-emerald-600 hover:bg-emerald-50 transition-colors\\\"\\n                      title=\\\"Marquer comme int\303\251ress\303\251\\\"\\n                    >\\n                      <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                    </button>\\n\\n                    <button\\n                      onClick={(e) => {\\n                        e.stopPropagation();\\n                        onDeleteProspect(prospect.id);\\n                      }}\\n                      className=\\\"p-1 rounded text-zinc-400 hover:text-rose-600 hover:bg-rose-50 transition-colors\\\"\\n                      title=\\\"Supprimer\\\"\\n                    >\\n                      <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n              </div>\\n            </motion.div>\\n          ))\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ProspectList.tsx\", \"toolAction\":\"Updating ProspectList component\", \"toolSummary\":\"Add Like / Identified interaction to prospect card\"}"
