      replacement_content: "import React, { useState } from \"react\";\nimport { Search, MapPin, Briefcase, Loader2, Sparkles, RefreshCw, Zap } from \"lucide-react\";\nimport { FreelanceProfile, SearchQuery } from \"../types\";\n\ninterface SearchPanelProps {\n  onSearch: (query: SearchQuery, forceRefresh?: boolean) => void;\n  loading: boolean;\n  freelanceProfile: FreelanceProfile;\n  onUpdateProfile: (profile: FreelanceProfile) => void;\n  fromCache?: boolean;\n}\n\nexport const SearchPanel: React.FC<SearchPanelProps> = ({\n  onSearch,\n  loading,\n  freelanceProfile,\n  onUpdateProfile,\n  fromCache,\n}) => {\n  const [city, setCity] = useState(freelanceProfile.targetCity || \"Bordeaux\");\n  const [sector, setSector] = useState(freelanceProfile.targetSector || \"Restaurants & Brasseries\");\n  const [specialty, setSpecialty] = useState(\"\");\n  const [isEditingProfile, setIsEditingProfile] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent, forceRefresh = false) => {\n    e.preventDefault();\n    if (!city.trim() || !sector.trim()) return;\n    onSearch({ city, sector, specialty }, forceRefresh);\n  };\n\n  return (\n    <div className=\"bg-white border border-zinc-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between\">\n      <div>\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 bg-zinc-100 rounded-lg text-zinc-800\">\n              <MapPin className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-semibold text-zinc-900\">Sourcing Local Cibl\303\251</h2>\n              <p className=\"text-xs text-zinc-500\">Recherche web & Google Maps</p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => setIsEditingProfile(!isEditingProfile)}\n            className=\"text-xs text-zinc-600 hover:text-zinc-900 font-medium px-2 py-1 rounded-md hover:bg-zinc-100 transition-colors\"\n          >\n            {isEditingProfile ? \"Fermer profil\" : \"Mon profil\"}\n          </button>\n        </div>\n\n        {isEditingProfile && (\n          <div className=\"mb-4 p-3 bg-zinc-50 border border-zinc-200/80 rounded-xl space-y-2.5 text-xs\">\n            <div>\n              <label className=\"block font-medium text-zinc-700 mb-1\">Votre expertise</label>\n              <input\n                type=\"text\"\n                value={freelanceProfile.title}\n                onChange={(e) => onUpdateProfile({ ...freelanceProfile, title: e.target.value })}\n                className=\"w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-md text-zinc-900\"\n                placeholder=\"Ex: D\303\251veloppeur Web & SEO Local\"\n              />\n            </div>\n            <div>\n              <label className=\"block font-medium text-zinc-700 mb-1\">Services propos\303\251s</label>\n              <input\n                type=\"text\"\n                value={freelanceProfile.services}\n                onChange={(e) => onUpdateProfile({ ...freelanceProfile, services: e.target.value })}\n                className=\"w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-md text-zinc-900\"\n                placeholder=\"Ex: Refonte de site, Click & Collect, fiche Google\"\n              />\n            </div>\n            <div>\n              <label className=\"block font-medium text-zinc-700 mb-1\">Proposition de valeur</label>\n              <textarea\n                rows={2}\n                value={freelanceProfile.valueProposition}\n                onChange={(e) => onUpdateProfile({ ...freelanceProfile, valueProposition: e.target.value })}\n                className=\"w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-md text-zinc-900 resize-none\"\n                placeholder=\"Ex: J\'aide les commerces locaux \303\240 doubler leurs r\303\251servations\"\n              />\n            </div>\n          </div>\n        )}\n\n        <form onSubmit={(e) => handleSubmit(e, false)} className=\"space-y-3 text-xs\">\n          <div>\n            <label className=\"block font-medium text-zinc-700 mb-1\">Ville ou zone g\303\251ographique</label>\n            <div className=\"relative\">\n              <MapPin className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400\" />\n              <input\n                type=\"text\"\n                value={city}\n                onChange={(e) => setCity(e.target.value)}\n                required\n                className=\"w-full pl-8 pr-3 py-2 bg-zinc-50/50 border border-zinc-200 rounded-lg text-zinc-900 text-xs focus:bg-white focus:outline-none focus:border-zinc-400 transition-colors\"\n                placeholder=\"Ex: Lyon, Nantes, Bordeaux Centre...\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block font-medium text-zinc-700 mb-1\">Secteur d\'activit\303\251 cible</label>\n            <div className=\"relative\">\n              <Briefcase className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400\" />\n              <input\n                type=\"text\"\n                value={sector}\n                onChange={(e) => setSector(e.target.value)}\n                required\n                className=\"w-full pl-8 pr-3 py-2 bg-zinc-50/50 border border-zinc-200 rounded-lg text-zinc-900 text-xs focus:bg-white focus:outline-none focus:border-zinc-400 transition-colors\"\n                placeholder=\"Ex: Artisans du b\303\242timent, Boulangeries, Ost\303\251opathes, Architectes...\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block font-medium text-zinc-700 mb-1\">Crit\303\250re ou sp\303\251cificit\303\251 (optionnel)</label>\n            <input\n              type=\"text\"\n              value={specialty}\n              onChange={(e) => setSpecialty(e.target.value)}\n              className=\"w-full px-3 py-2 bg-zinc-50/50 border border-zinc-200 rounded-lg text-zinc-900 text-xs focus:bg-white focus:outline-none focus:border-zinc-400 transition-colors\"\n              placeholder=\"Ex: Sans site internet, note < 4.2, ind\303\251pendants...\"\n            />\n          </div>\n\n          <div className=\"pt-1 flex gap-2\">\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"flex-1 py-2.5 px-4 bg-zinc-900 hover:bg-zinc-800 text-white rounded-xl text-xs font-medium transition-colors flex items-center justify-center gap-2 disabled:opacity-60 shadow-xs\"\n            >\n              {loading ? (\n                <>\n                  <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Analyse en cours...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-3.5 h-3.5 text-amber-300\" />\n                  <span>Lancer la recherche</span>\n                </>\n              )}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={(e) => handleSubmit(e, true)}\n              disabled={loading}\n              className=\"px-3 py-2.5 bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 rounded-xl text-xs font-medium transition-colors flex items-center justify-center gap-1.5 disabled:opacity-50\"\n              title=\"Forcer une nouvelle requ\303\252te IA (contourner le cache)\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5 text-zinc-500\" />\n            </button>\n          </div>\n        </form>\n      </div>\n\n      {/* Credit saving indicator */}\n      <div className=\"mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between text-[11px]\">\n        <div className=\"flex items-center gap-1 text-emerald-700 font-medium\">\n          <Zap className=\"w-3 h-3 text-emerald-600\" />\n          <span>\303\211conomie de cr\303\251dits IA active</span>\n        </div>\n        <span className=\"font-mono text-zinc-400\">Cache 24h & Anti-doublons</span>\n      </div>\n    </div>\n  );\n};\n"
    }
