\n          {/* Step 1: D\303\251couverts / Scann\303\251s */}\n          <button\n            onClick={() => onFilterSelect(\"all\")}\n            className={`text-left p-3 rounded-xl border transition-all ${\n              activeFilter === \"all\"\n                ? \"bg-zinc-900 text-white border-zinc-900 shadow-xs\"\n                : \"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\"\n            }`}\n          >\n            <div className=\"flex items-center justify-between mb-1\">\n              <span className={`text-[11px] font-medium ${activeFilter === \"all\" ? \"text-zinc-300\" : \"text-zinc-500\"}`}>\n                1. D\303\251couverts\n              </span>\n              <Search className={`w-3.5 h-3.5 ${activeFilter === \"all\" ? \"text-zinc-300\" : \"text-zinc-400\"}`} />\n            </div>\n            <div className=\"text-2xl font-bold tracking-tight\">{totalDiscovered}</div>\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \"all\" ? \"text-zinc-300\" : \"text-zinc-500\"}`}>\n              Recherche Web & Maps\n            </div>\n          </button>\n\n          {/* Step 2: Identifi\303\251s (Lik\303\251s) */}\n          <button\n            onClick={() => onFilterSelect(\"identified\")}\n            className={`text-left p-3 rounded-xl border transition-all ${\n              activeFilter === \"identified\"\n                ? \"bg-emerald-700 text-white border-emerald-800 shadow-xs\"\n                : \"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\"\n            }`}\n          >\n            <div className=\"flex items-center justify-between mb-1\">\n              <span className={`text-[11px] font-medium ${activeFilter === \"identified\" ? \"text-emerald-200\" : \"text-emerald-700\"}`}>\n                2. Identifi\303\251s (Lik\303\251s)\n              </span>\n              <Heart className={`w-3.5 h-3.5 ${activeFilter === \"identified\" ? \"text-emerald-200 fill-emerald-200\" : \"text-emerald-600\"}`} />\n            </div>\n            <div className=\"text-2xl font-bold tracking-tight\">{identifiedCount}</div>\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \"identified\" ? \"text-emerald-200\" : \"text-zinc-500\"}`}>\n              Cibles qualifi\303\251es \303\240 traiter\n            </div>\n          </button>\n\n          {/* Step 3: Contact\303\251s */}\n          <button\n            onClick={() => onFilterSelect(\"contacted\")}\n            className={`text-left p-3 rounded-xl border transition-all ${\n              activeFilter === \"contacted\"\n                ? \"bg-blue-700 text-white border-blue-800 shadow-xs\"\n                : \"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\"\n            }`}\n          >\n            <div className=\"flex items-center justify-between mb-1\">\n              <span className={`text-[11px] font-medium ${activeFilter === \"contacted\" ? \"text-blue-200\" : \"text-blue-700\"}`}>\n                3. Contact\303\251s\n              </span>\n              <Send className={`w-3.5 h-3.5 ${activeFilter === \"contacted\" ? \"text-blue-200\" : \"text-blue-600\"}`} />\n            </div>\n            <div className=\"text-2xl font-bold tracking-tight\">{contactedCount}</div>\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \"contacted\" ? \"text-blue-200\" : \"text-zinc-500\"}`}>\n              Mails IA envoy\303\251s (Gmail)\n            </div>\n          </button>\n\n          {/* Step 4: Int\303\251ress\303\251s */}\n          <button\n            onClick={() => onFilterSelect(\"interested\")}\n            className={`text-left p-3 rounded-xl border transition-all ${\n              activeFilter === \"interested\"\n                ? \"bg-purple-700 text-white border-purple-800 shadow-xs\"\n                : \"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\"\n            }`}\n          >\n            <div className=