      arguments_json: "{\"Content\":\"import React from \\\"react\\\";\\nimport { Search, Heart, Send, CheckCircle2, ArrowRight } from \\\"lucide-react\\\";\\nimport { Prospect } from \\\"../types\\\";\\n\\ninterface StatsBentoProps {\\n  prospects: Prospect[];\\n  activeFilter: string;\\n  onFilterSelect: (filter: string) => void;\\n}\\n\\nexport const StatsBento: React.FC<StatsBentoProps> = ({ \\n  prospects,\\n  activeFilter,\\n  onFilterSelect,\\n}) => {\\n  // Sourcing pipeline :\\n  // 1. D\303\251couverts (Total des prospects scann\303\251s)\\n  // 2. Identifi\303\251s / Lik\303\251s (Retenus par le freelance pour action)\\n  // 3. Contact\303\251s (Email g\303\251n\303\251r\303\251 et envoy\303\251 via Gmail)\\n  // 4. Int\303\251ress\303\251s (Opportunit\303\251s qualifi\303\251es)\\n  const totalDiscovered = prospects.length;\\n  const identifiedList = prospects.filter((p) => p.identified || p.status !== \\\"to_contact\\\");\\n  const identifiedCount = identifiedList.length;\\n  const contactedCount = prospects.filter((p) => p.status === \\\"contacted\\\").length;\\n  const interestedCount = prospects.filter((p) => p.status === \\\"interested\\\").length;\\n\\n  const conversionRate = contactedCount > 0 ? Math.round((interestedCount / contactedCount) * 100) : 0;\\n\\n  return (\\n    <div className=\\\"space-y-3\\\">\\n      {/* Pipeline Navigation Bar */}\\n      <div className=\\\"bg-white border border-zinc-200/80 rounded-2xl p-4 shadow-xs\\\">\\n        <div className=\\\"flex items-center justify-between mb-3\\\">\\n          <span className=\\\"text-xs font-semibold text-zinc-900 tracking-wide uppercase\\\">\\n            Pipeline de prospection locale\\n          </span>\\n          <span className=\\\"text-[11px] text-zinc-400 font-mono\\\">\\n            {identifiedCount} cible{identifiedCount > 1 ? \\\"s\\\" : \\\"\\\"} valid\303\251e{identifiedCount > 1 ? \\\"s\\\" : \\\"\\\"} sur {totalDiscovered} scann\303\251e{totalDiscovered > 1 ? \\\"s\\\" : \\\"\\\"}\\n          </span>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-2 md:grid-cols-4 gap-3\\\">\\n          {/* Step 1: D\303\251couverts / Scann\303\251s */}\\n          <button\\n            onClick={() => onFilterSelect(\\\"all\\\")}\\n            className={`text-left p-3 rounded-xl border transition-all ${\\n              activeFilter === \\\"all\\\"\\n                ? \\\"bg-zinc-900 text-white border-zinc-900 shadow-xs\\\"\\n                : \\\"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\\\"\\n            }`}\\n          >\\n            <div className=\\\"flex items-center justify-between mb-1\\\">\\n              <span className={`text-[11px] font-medium ${activeFilter === \\\"all\\\" ? \\\"text-zinc-300\\\" : \\\"text-zinc-500\\\"}`}>\\n                1. D\303\251couverts\\n              </span>\\n              <Search className={`w-3.5 h-3.5 ${activeFilter === \\\"all\\\" ? \\\"text-zinc-300\\\" : \\\"text-zinc-400\\\"}`} />\\n            </div>\\n            <div className=\\\"text-2xl font-bold tracking-tight\\\">{totalDiscovered}</div>\\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \\\"all\\\" ? \\\"text-zinc-300\\\" : \\\"text-zinc-500\\\"}`}>\\n              Recherche Web & Maps\\n            </div>\\n          </button>\\n\\n          {/* Step 2: Identifi\303\251s (Lik\303\251s) */}\\n          <button\\n            onClick={() => onFilterSelect(\\\"identified\\\")}\\n            className={`text-left p-3 rounded-xl border transition-all ${\\n              activeFilter === \\\"identified\\\"\\n                ? \\\"bg-emerald-700 text-white border-emerald-800 shadow-xs\\\"\\n                : \\\"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\\\"\\n            }`}\\n          >\\n            <div className=\\\"flex items-center justify-between mb-1\\\">\\n              <span className={`text-[11px] font-medium ${activeFilter === \\\"identified\\\" ? \\\"text-emerald-200\\\" : \\\"text-emerald-700\\\"}`}>\\n                2. Identifi\303\251s (Lik\303\251s)\\n              </span>\\n              <Heart className={`w-3.5 h-3.5 ${activeFilter === \\\"identified\\\" ? \\\"text-emerald-200 fill-emerald-200\\\" : \\\"text-emerald-600\\\"}`} />\\n            </div>\\n            <div className=\\\"text-2xl font-bold tracking-tight\\\">{identifiedCount}</div>\\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \\\"identified\\\" ? \\\"text-emerald-200\\\" : \\\"text-zinc-500\\\"}`}>\\n              Cibles qualifi\303\251es \303\240 traiter\\n            </div>\\n          </button>\\n\\n          {/* Step 3: Contact\303\251s */}\\n          <button\\n            onClick={() => onFilterSelect(\\\"contacted\\\")}\\n            className={`text-left p-3 rounded-xl border transition-all ${\\n              activeFilter === \\\"contacted\\\"\\n                ? \\\"bg-blue-700 text-white border-blue-800 shadow-xs\\\"\\n                : \\\"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\\\"\\n            }`}\\n          >\\n            <div className=\\\"flex items-center justify-between mb-1\\\">\\n              <span className={`text-[11px] font-medium ${activeFilter === \\\"contacted\\\" ? \\\"text-blue-200\\\" : \\\"text-blue-700\\\"}`}>\\n                3. Contact\303\251s\\n              </span>\\n              <Send className={`w-3.5 h-3.5 ${activeFilter === \\\"contacted\\\" ? \\\"text-blue-200\\\" : \\\"text-blue-600\\\"}`} />\\n            </div>\\n            <div className=\\\"text-2xl font-bold tracking-tight\\\">{contactedCount}</div>\\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \\\"contacted\\\" ? \\\"text-blue-200\\\" : \\\"text-zinc-500\\\"}`}>\\n              Mails IA envoy\303\251s (Gmail)\\n            </div>\\n          </button>\\n\\n          {/* Step 4: Int\303\251ress\303\251s */}\\n          <button\\n            onClick={() => onFilterSelect(\\\"interested\\\")}\\n            className={`text-left p-3 rounded-xl border transition-all ${\\n              activeFilter === \\\"interested\\\"\\n                ? \\\"bg-purple-700 text-white border-purple-800 shadow-xs\\\"\\n                : \\\"bg-zinc-50/70 hover:bg-zinc-100/70 text-zinc-800 border-zinc-200/70\\\"\\n            }`}\\n          >\\n            <div className=\\\"flex items-center justify-between mb-1\\\">\\n              <span className={`text-[11px] font-medium ${activeFilter === \\\"interested\\\" ? \\\"text-purple-200\\\" : \\\"text-purple-700\\\"}`}>\\n                4. Int\303\251ress\303\251s\\n              </span>\\n              <CheckCircle2 className={`w-3.5 h-3.5 ${activeFilter === \\\"interested\\\" ? \\\"text-purple-200\\\" : \\\"text-purple-600\\\"}`} />\\n            </div>\\n            <div className=\\\"text-2xl font-bold tracking-tight\\\">{interestedCount}</div>\\n            <div className={`text-[10px] mt-0.5 ${activeFilter === \\\"interested\\\" ? \\\"text-purple-200\\\" : \\\"text-zinc-500\\\"}`}>\\n              Taux transfo : {conversionRate}%\\n            </div>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/StatsBento.tsx\", \"toolAction\":\"Updating StatsBento component\", \"toolSummary\":\"Update pipeline steps with Liked/Identified logic\"}"
