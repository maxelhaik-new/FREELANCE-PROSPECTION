    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Users, Send, CheckCircle, TrendingUp } from \"lucide-react\";\nimport { Prospect } from \"../types\";\n\ninterface StatsBentoProps {\n  prospects: Prospect[];\n}\n\nexport const StatsBento: React.FC<StatsBentoProps> = ({ prospects }) => {\n  const total = prospects.length;\n  const contacted = prospects.filter((p) => p.status === \"contacted\").length;\n  const interested = prospects.filter((p) => p.status === \"interested\").length;\n  const toContact = prospects.filter((p) => p.status === \"to_contact\").length;\n  const conversionRate = contacted > 0 ? Math.round((interested / contacted) * 100) : 0;\n\n  return (\n    <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n      <div className=\"bg-white border border-zinc-200/80 rounded-xl p-3.5 shadow-xs flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-zinc-500\">\n          <span className=\"text-xs font-medium uppercase tracking-wider text-zinc-400\">Total Prospects</span>\n          <Users className=\"w-4 h-4 text-zinc-400\" />\n        </div>\n        <div className=\"mt-2 text-2xl font-semibold tracking-tight text-zinc-900\">{total}</div>\n        <div className=\"text-[11px] text-zinc-500 mt-0.5\">{toContact} \303\240 contacter</div>\n      </div>\n\n      <div className=\"bg-white border border-zinc-200/80 rounded-xl p-3.5 shadow-xs flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-zinc-500\">\n          <span className=\"text-xs font-medium uppercase tracking-wider text-zinc-400\">Contact\303\251s</span>\n          <Send className=\"w-4 h-4 text-blue-500\" />\n        </div>\n        <div className=\"mt-2 text-2xl font-semibold tracking-tight text-zinc-900\">{contacted}</div>\n        <div className=\"text-[11px] text-zinc-500 mt-0.5\">Mails personnalis\303\251s envoy\303\251s</div>\n      </div>\n\n      <div className=\"bg-white border border-zinc-200/80 rounded-xl p-3.5 shadow-xs flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-zinc-500\">\n          <span className=\"text-xs font-medium uppercase tracking-wider text-zinc-400\">Int\303\251ress\303\251s</span>\n          <CheckCircle className=\"w-4 h-4 text-emerald-500\" />\n        </div>\n        <div className=\"mt-2 text-2xl font-semibold tracking-tight text-emerald-600\">{interested}</div>\n        <div className=\"text-[11px] text-zinc-500 mt-0.5\">Opportunit\303\251s actives</div>\n      </div>\n\n      <div className=\"bg-white border border-zinc-200/80 rounded-xl p-3.5 shadow-xs flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-zinc-500\">\n          <span className=\"text-xs font-medium uppercase tracking-wider text-zinc-400\">Taux R\303\251ponse</span>\n          <TrendingUp className=\"w-4 h-4 text-violet-500\" />\n        </div>\n        <div className=\"mt-2 text-2xl font-semibold tracking-tight text-zinc-900\">{conversionRate}%</div>\n        <div className=\"text-[11px] text-zinc-500 mt-0.5\">Ratio int\303\251r\303\252t / envois</div>\n      </div>\n    </div>\n  );\n};\n"
    }
