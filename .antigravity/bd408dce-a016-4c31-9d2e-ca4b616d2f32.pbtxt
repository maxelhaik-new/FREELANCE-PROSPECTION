  file_change {
    absolute_path_uri: "file:///src/components/ProspectList.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef } from \"react\";\nimport { \n  MapPin, \n  Star, \n  ChevronRight, \n  CheckCircle2, \n  Clock, \n  HeartHandshake, \n  Trash2, \n  Heart, \n  Mail\n} from \"lucide-react\";\nimport { motion } from \"motion/react\";\nimport { Prospect } from \"../types\";\n\ninterface ProspectListProps {\n  prospects: Prospect[];\n  onSelectProspect: (prospect: Prospect) => void;\n  onOpenEmailModal: (prospect: Prospect) => void;\n  onUpdateStatus: (id: string, status: Prospect[\"status\"]) => void;\n  onToggleIdentified: (id: string) => void;\n  onDeleteProspect: (id: string) => void;\n  selectedId: string | null;\n  filterStatus: string;\n  onFilterChange: (status: string) => void;\n  currentSearchQuery?: { city: string; sector: string } | null;\n}\n\nexport const ProspectList: React.FC<ProspectListProps> = ({\n  prospects,\n  onSelectProspect,\n  onOpenEmailModal,\n  onUpdateStatus,\n  onToggleIdentified,\n  onDeleteProspect,\n  selectedId,\n  filterStatus,\n  onFilterChange,\n  currentSearchQuery,\n}) => {\n  const itemRefs = useRef<Map<string, HTMLDivElement>>(new Map());\n\n  const filtered = prospects.filter((p) => {\n    if (filterStatus === \"all\") return true;\n    if (filterStatus === \"identified\") return p.identified;\n    return p.status === filterStatus;\n  });\n\n  // Auto-scroll list to bring selected prospect into view when chosen on map or in list\n  useEffect(() => {\n    if (selectedId) {\n      const el = itemRefs.current.get(selectedId);\n      if (el) {\n        el.scrollIntoView({ behavior: \"smooth\", block: \"nearest\" });\n      }\n    }\n  }, [selectedId]);\n\n  const getStatusBadge = (status: Prospect[\"status\"]) => {\n    switch (status) {\n      case \"contacted\":\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200 shrink-0\">\n            <Clock className=\"w-3 h-3\" />\n            Contact\303\251\n          </span>\n        );\n      case \"interested\":\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0\">\n            <HeartHandshake className=\"w-3 h-3\" />\n            Int\303\251ress\303\251\n          </span>\n        );\n      case \"declined\":\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-zinc-100 text-zinc-600 border border-zinc-200 shrink-0\">\n            Sans suite\n          </span>\n        );\n      default:\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200 shrink-0\">\n            \303\200 contacter\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div className=\"bg-white border border-zinc-200 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col h-full\">\n      {/* Header & Filter pills */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3.5 border-b border-zinc-100\">\n        <div>\n          <h2 className=\"text-sm font-semibold text-zinc-900\">\n            {filterStatus === \"identified\"\n              ? \"Prospects Identifi\303\251s (Lik\303\251s)\"\n              : filterStatus === \"contacted\"\n              ? \"Prospects Contact\303\251s\"\n              : filterStatus === \"interested\"\n              ? \"Prospects Int\303\251ress\303\251s\"\n              : \"Prospects Disponibles\"}\n          </h2>\n          <p className=\"text-xs text-zinc-500 mt-0.5\">\n            {filtered.length} affich\303\251{filtered.length > 1 ? \"s\" : \"\"}\n            {currentSearchQuery && filterStatus === \"all\" ? ` pour ${currentSearchQuery.city}` : \"\"}\n          </p>\n        </div>\n\n        {/* Filter Badges */}\n        <div className=\"flex items-center gap-1.5 flex-wrap text-xs\">\n          {[\n            { key: \"all\", label: \"Tous\" },\n            { key: \"identified\", label: \"Identifi\303\251s (Lik\303\251s)\" },\n            { key: \"contacted\", label: \"Contact\303\251s\" },\n            { key: \"interested\", label: \"Int\303\251ress\303\251s\" },\n          ].map((item) => (\n            <button\n              key={item.key}\n              onClick={() => onFilterChange(item.key)}\n              className={`px-2.5 py-1 rounded-lg font-medium transition-colors text-[11px] whitespace-nowrap ${\n                filterStatus === item.key\n                  ? \"bg-zinc-900 text-white\"\n                  : \"text-zinc-600 hover:bg-zinc-100\"\n              }`}\n            >\n              {item.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Prospect cards list */}\n      <div className=\"mt-3.5 space-y-3 overflow-y-auto max-h-[580px] pr-1 scroll-smooth\">\n        {filtered.length === 0 ? (\n          <div className=\"py-12 text-center text-zinc-400 text-xs\">\n            {filterStatus === \"identified\"\n              ? \"Aucun prospect lik\303\251. Cliquez sur le c\305\223ur pour identifier et retenir vos cibles.\"\n              : \"Aucun prospect dans cette vue.\"}\n          </div>\n        ) : (\n          filtered.map((prospect) => {\n            const isSelected = selectedId === prospect.id;\n            return (\n              <motion.div\n                key={prospect.id}\n                ref={(el) => {\n                  if (el) itemRefs.current.set(prospect.id, el);\n                  else itemRefs.current.delete(prospect.id);\n                }}\n                layout\n                initial={{ opacity: 0, y: 4 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.15 }}\n                className={`p-4 rounded-xl border transition-all cursor-pointer ${\n                  isSelected\n                    ? \"border-zinc-900 bg-zinc-50/90 ring-2 ring-zinc-900/10 shadow-sm\"\n                    : \"border-zinc-200/90 hover:border-zinc-300 bg-white\"\n                }`}\n                onClick={() => onSelectProspect(prospect)}\n              >\n                {/* Row 1: Heart button + Title + Badges + Action Buttons */}\n                <div className=\"flex items-start justify-between gap-2.5\">\n                  <div className=\"flex items-start gap-2.5 min-w-0 flex-1\">\n                    {/* Heart / Like toggle button */}\n                    <button\n                      type=\"button\"\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onToggleIdentified(prospect.id);\n                      }}\n                      className={`p-1.5 rounded-lg transition-colors shrink-0 mt-0.5 ${\n                        prospect.identified\n                          ? \"text-emerald-600 bg-emerald-50 hover:bg-emerald-100\"\n                          : \"text-zinc-300 hover:text-emerald-600 hover:bg-zinc-100\"\n                      }`}\n                      title={prospect.identified ? \"Retirer de la s\303\251lection\" : \"Liker / Retenir ce prospect\"}\n                    >\n                      <Heart\n                        className={`w-4 h-4 ${prospect.identified ? \"fill-emerald-600\" : \"\"}`}\n                      />\n                    </button>\n\n                    <div className=\"min-w-0 flex-1\">\n                      {/* Company name */}\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        <h3 className={`font-semibold text-sm leading-snug ${isSelected ? \"text-zinc-900 font-bold\" : \"text-zinc-900\"}`}>\n                          {prospect.name}\n                        </h3>\n                        {getStatusBadge(prospect.status)}\n                        {prospect.identified && (\n                          <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium shrink-0\">\n                            Retenu\n                          </span>\n                        )}\n                        {prospect.generatedEmail && (\n                          <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-200 font-medium shrink-0\">\n                            Email pr\303\252t\n                          </span>\n                        )}\n                      </div>\n\n                      {/* Metadata line */}\n                      <div className=\"flex flex-wrap items-center gap-y-1 gap-x-2.5 mt-1.5 text-xs text-zinc-600\">\n                        <span className=\"font-medium text-zinc-700\">{prospect.activity}</span>\n                        <span className=\"text-zinc-300\">\342\200\242</span>\n                        <span className=\"flex items-center gap-1 text-zinc-500\">\n                          <MapPin className=\"w-3.5 h-3.5 text-zinc-400 shrink-0\" />\n                          <span>{prospect.location}</span>\n                        </span>\n                        {prospect.rating ? (\n                          <>\n                            <span className=\"text-zinc-300\">\342\200\242</span>\n                            <span className=\"flex items-center gap-1 text-amber-600 font-medium\">\n                              <Star className=\"w-3.5 h-3.5 fill-amber-400 text-amber-400 shrink-0\" />\n                              <span>{prospect.rating}</span>\n                              {prospect.reviewCount ? (\n                                <span className=\"text-zinc-400 font-normal\">({prospect.reviewCount} avis)</span>\n                              ) : null}\n                            </span>\n                          </>\n                        ) : null}\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Right controls: Distinct button to explicitly open contact/mail modal */}\n                  <div className=\"flex items-center gap-1 shrink-0 ml-1\">\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onUpdateStatus(\n                          prospect.id,\n                          prospect.status === \"interested\" ? \"contacted\" : \"interested\"\n                        );\n                      }}\n                      className=\"p-1.5 rounded-lg text-zinc-400 hover:text-emerald-600 hover:bg-emerald-50 transition-colors\"\n                      title=\"Marquer comme int\303\251ress\303\251\"\n                    >\n                      <CheckCircle2 className=\"w-4 h-4\" />\n                    </button>\n\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onDeleteProspect(prospect.id);\n                      }}\n                      className=\"p-1.5 rounded-lg text-zinc-400 hover:text-rose-600 hover:bg-rose-50 transition-colors\"\n                      title=\"Supprimer\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onOpenEmailModal(prospect);\n                      }}\n                      className=\"px-2.5 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium transition-colors flex items-center gap-1 ml-1 shadow-2xs\"\n                      title=\"R\303\251diger l\'email personnalis\303\251\"\n                    >\n                      <Mail className=\"w-3.5 h-3.5 text-zinc-300\" />\n                      <span className=\"hidden sm:inline\">Mail IA</span>\n                      <ChevronRight className=\"w-3 h-3 text-zinc-400\" />\n                    </button>\n                  </div>\n                </div>\n\n                {/* Row 2: Full Opportunity Angle Box */}\n                <div className={`mt-3 p-2.5 rounded-lg border text-xs leading-relaxed ${\n                  isSelected \n                    ? \"bg-white border-zinc-300 text-zinc-900\" \n                    : \"bg-zinc-50 border-zinc-100 text-zinc-700\"\n                }`}>\n                  <span className=\"font-semibold text-zinc-900 mr-1.5\">Angle d\'opportunit\303\251 :</span>\n                  {prospect.keyAngle}\n                </div>\n              </motion.div>\n            );\n          })\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
