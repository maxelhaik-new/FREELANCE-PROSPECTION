      arguments_json: "{\"Instruction\":\"Add Like / Identify button in ProspectDetailModal header\", \"ReplacementContent\":\"          {/* Header */}\\n          <div className=\\\"p-4 sm:p-5 border-b border-zinc-100 flex items-start justify-between gap-4 bg-zinc-50/50\\\">\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    onUpdateProspect({\\n                      ...prospect,\\n                      identified: !prospect.identified,\\n                    });\\n                  }}\\n                  className={`p-1 rounded-md transition-colors ${\\n                    prospect.identified\\n                      ? \\\"text-emerald-600 bg-emerald-50 hover:bg-emerald-100\\\"\\n                      : \\\"text-zinc-400 hover:text-emerald-600 hover:bg-zinc-200/50\\\"\\n                  }`}\\n                  title={prospect.identified ? \\\"Retirer de la s\303\251lection\\\" : \\\"Liker / Identifier pour le pipeline\\\"}\\n                >\\n                  <Sparkles className={`w-4 h-4 ${prospect.identified ? \\\"fill-emerald-600\\\" : \\\"\\\"}`} />\\n                </button>\\n                <h3 className=\\\"text-base font-semibold text-zinc-900\\\">{prospect.name}</h3>\\n                <span className=\\\"text-[11px] px-2 py-0.5 rounded-full bg-zinc-200/80 text-zinc-700 font-medium\\\">\\n                  {prospect.activity}\\n                </span>\\n                {prospect.identified && (\\n                  <span className=\\\"text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium\\\">\\n                    Identifi\303\251\\n                  </span>\\n                )}\\n              </div>\\n\", \"TargetContent\":\"          {/* Header */}\\n          <div className=\\\"p-4 sm:p-5 border-b border-zinc-100 flex items-start justify-between gap-4 bg-zinc-50/50\\\">\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <h3 className=\\\"text-base font-semibold text-zinc-900\\\">{prospect.name}</h3>\\n                <span className=\\\"text-[11px] px-2 py-0.5 rounded-full bg-zinc-200/80 text-zinc-700 font-medium\\\">\\n                  {prospect.activity}\\n                </span>\\n              </div>\\n\", \"TargetFile\":\"/src/components/ProspectDetailModal.tsx\", \"toolAction\":\"Editing ProspectDetailModal header\", \"toolSummary\":\"Add identified toggle to modal header\"}"
