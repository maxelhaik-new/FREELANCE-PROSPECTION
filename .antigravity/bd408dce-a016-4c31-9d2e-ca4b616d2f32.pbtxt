  view_file {
    absolute_path_uri: "file:///src/components/ProspectDetailModal.tsx"
    start_line: 70
    end_line: 144
    content: "\n      const updated = {\n        ...prospect,\n        generatedEmail: {\n          subject: data.subject,\n          body: data.body,\n          generatedAt: new Date().toISOString(),\n        },\n      };\n      onUpdateProspect(updated);\n    } catch (err: any) {\n      setActionError(err.message || \"Erreur de g\303\251n\303\251ration\");\n    } finally {\n      setGenerating(false);\n    }\n  };\n\n  const handleSendViaGmail = async () => {\n    if (!gmailToken) {\n      setActionError(\"Veuillez connecter votre compte Gmail pour envoyer l\'email directement.\");\n      return;\n    }\n    if (!emailInput.trim()) {\n      setActionError(\"Veuillez renseigner l\'adresse email de contact du prospect.\");\n      return;\n    }\n    if (!subject.trim() || !body.trim()) {\n      setActionError(\"L\'objet et le corps de l\'email ne peuvent pas \303\252tre vides.\");\n      return;\n    }\n\n    setSending(true);\n    setActionError(null);\n    setActionSuccess(null);\n\n    try {\n      const res = await fetch(\"/api/gmail/send\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          Authorization: `Bearer ${gmailToken}`,\n        },\n        body: JSON.stringify({\n          to: emailInput.trim(),\n          subject,\n          body,\n        }),\n      });\n\n      const data = await res.json();\n      if (!res.ok) {\n        throw new Error(data.error || \"\303\211chec de l\'envoi\");\n      }\n\n      setActionSuccess(\"Email envoy\303\251 avec succ\303\250s via Gmail !\");\n      onUpdateProspect({\n        ...prospect,\n        email: emailInput.trim(),\n        status: \"contacted\",\n        emailSentAt: new Date().toISOString(),\n      });\n    } catch (err: any) {\n      setActionError(err.message || \"Erreur d\'envoi\");\n    } finally {\n      setSending(false);\n    }\n  };\n\n  const handleCreateDraft = async () => {\n    if (!gmailToken) {\n      setActionError(\"Veuillez connecter votre compte Gmail pour cr\303\251er un brouillon.\");\n      return;\n    }\n\n    setDrafting(true);"
    raw_content: "import React, { useState } from \"react\";\nimport { \n  Sparkles, \n  Send, \n  FileEdit, \n  Copy, \n  Check, \n  ExternalLink, \n  Phone, \n  Mail as MailIcon, \n  MapPin, \n  Star, \n  Loader2, \n  CheckCircle2,\n  AlertCircle\n} from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { Prospect, FreelanceProfile } from \"../types\";\n\ninterface ProspectDetailModalProps {\n  prospect: Prospect | null;\n  onClose: () => void;\n  freelanceProfile: FreelanceProfile;\n  onUpdateProspect: (updated: Prospect) => void;\n  gmailToken: string | null;\n}\n\nexport const ProspectDetailModal: React.FC<ProspectDetailModalProps> = ({\n  prospect,\n  onClose,\n  freelanceProfile,\n  onUpdateProspect,\n  gmailToken,\n}) => {\n  if (!prospect) return null;\n\n  const [generating, setGenerating] = useState(false);\n  const [sending, setSending] = useState(false);\n  const [drafting, setDrafting] = useState(false);\n  const [subject, setSubject] = useState(prospect.generatedEmail?.subject || \"\");\n  const [body, setBody] = useState(prospect.generatedEmail?.body || \"\");\n  const [copied, setCopied] = useState(false);\n  const [emailInput, setEmailInput] = useState(prospect.email || \"\");\n  const [tone, setTone] = useState(\"Direct et courtois\");\n  const [objective, setObjective] = useState(\"Proposition d\'audit gratuit de 10 min\");\n  const [actionSuccess, setActionSuccess] = useState<string | null>(null);\n  const [actionError, setActionError] = useState<string | null>(null);\n\n  const handleGenerateEmail = async () => {\n    setGenerating(true);\n    setActionError(null);\n    try {\n      const res = await fetch(\"/api/prospects/generate-email\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          prospect,\n          freelanceProfile,\n          tone,\n          objective,\n        }),\n      });\n\n      if (!res.ok) {\n        throw new Error(\"Impossible de g\303\251n\303\251rer le mail\");\n      }\n\n      const data = await res.json();\n      setSubject(data.subject);\n      setBody(data.body);\n\n      const updated = {\n        ...prospect,\n        generatedEmail: {\n          subject: data.subject,\n          body: data.body,\n          generatedAt: new Date().toISOString(),\n        },\n      };\n      onUpdateProspect(updated);\n    } catch (err: any) {\n      setActionError(err.message || \"Erreur de g\303\251n\303\251ration\");\n    } finally {\n      setGenerating(false);\n    }\n  };\n\n  const handleSendViaGmail = async () => {\n    if (!gmailToken) {\n      setActionError(\"Veuillez connecter votre compte Gmail pour envoyer l\'email directement.\");\n      return;\n    }\n    if (!emailInput.trim()) {\n      setActionError(\"Veuillez renseigner l\'adresse email de contact du prospect.\");\n      return;\n    }\n    if (!subject.trim() || !body.trim()) {\n      setActionError(\"L\'objet et le corps de l\'email ne peuvent pas \303\252tre vides.\");\n      return;\n    }\n\n    setSending(true);\n    setActionError(null);\n    setActionSuccess(null);\n\n    try {\n      const res = await fetch(\"/api/gmail/send\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          Authorization: `Bearer ${gmailToken}`,\n        },\n        body: JSON.stringify({\n          to: emailInput.trim(),\n          subject,\n          body,\n        }),\n      });\n\n      const data = await res.json();\n      if (!res.ok) {\n        throw new Error(data.error || \"\303\211chec de l\'envoi\");\n      }\n\n      setActionSuccess(\"Email envoy\303\251 avec succ\303\250s via Gmail !\");\n      onUpdateProspect({\n        ...prospect,\n        email: emailInput.trim(),\n        status: \"contacted\",\n        emailSentAt: new Date().toISOString(),\n      });\n    } catch (err: any) {\n      setActionError(err.message || \"Erreur d\'envoi\");\n    } finally {\n      setSending(false);\n    }\n  };\n\n  const handleCreateDraft = async () => {\n    if (!gmailToken) {\n      setActionError(\"Veuillez connecter votre compte Gmail pour cr\303\251er un brouillon.\");\n      return;\n    }\n\n    setDrafting(true);\n    setActionError(null);\n    setActionSuccess(null);\n\n    try {\n      const res = await fetch(\"/api/gmail/draft\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          Authorization: `Bearer ${gmailToken}`,\n        },\n        body: JSON.stringify({\n          to: emailInput.trim(),\n          subject,\n          body,\n        }),\n      });\n\n      const data = await res.json();\n      if (!res.ok) {\n        throw new Error(data.error || \"\303\211chec de la cr\303\251ation du brouillon\");\n      }\n\n      setActionSuccess(\"Brouillon cr\303\251\303\251 dans votre bo\303\256te Gmail !\");\n    } catch (err: any) {\n      setActionError(err.message || \"Erreur de cr\303\251ation de brouillon\");\n    } finally {\n      setDrafting(false);\n    }\n  };\n\n  const handleCopy = () => {\n    const textToCopy = `Objet: ${subject}\\n\\n${body}`;\n    navigator.clipboard.writeText(textToCopy);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 overflow-y-auto\">\n        <motion.div\n          initial={{ opacity: 0, scale: 0.96, y: 8 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.96, y: 8 }}\n          transition={{ duration: 0.16 }}\n          className=\"bg-white border border-zinc-200 rounded-2xl w-full max-w-3xl shadow-xl overflow-hidden my-auto\"\n        >\n          {/* Header */}\n          <div className=\"p-4 sm:p-5 border-b border-zinc-100 flex items-start justify-between gap-4 bg-zinc-50/50\">\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-base font-semibold text-zinc-900\">{prospect.name}</h3>\n                <span className=\"text-[11px] px-2 py-0.5 rounded-full bg-zinc-200/80 text-zinc-700 font-medium\">\n                  {prospect.activity}\n                </span>\n              </div>\n              <div className=\"flex flex-wrap items-center gap-3 mt-1.5 text-xs text-zinc-500\">\n                <span className=\"flex items-center gap-1\">\n                  <MapPin className=\"w-3.5 h-3.5 text-zinc-400\" />\n                  {prospect.location}\n                </span>\n                {prospect.rating ? (\n                  <span className=\"flex items-center gap-1 text-amber-600\">\n                    <Star className=\"w-3 h-3 fill-amber-400 text-amber-400\" />\n                    {prospect.rating} ({prospect.reviewCount} avis)\n                  </span>\n                ) : null}\n                {prospect.website ? (\n                  <a\n                    href={prospect.website.startsWith(\"http\") ? prospect.website : `https://${prospect.website}`}\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    className=\"flex items-center gap-1 text-blue-600 hover:underline\"\n                  >\n                    <ExternalLink className=\"w-3.5 h-3.5\" />\n                    Site web\n                  </a>\n                ) : (\n                  <span className=\"text-zinc-400\">Sans site r\303\251pertori\303\251</span>\n                )}\n              </div>\n            </div>\n\n            <button\n              onClick={onClose}\n              className=\"text-zinc-400 hover:text-zinc-700 p-1 rounded-lg hover:bg-zinc-100 transition-colors text-sm\"\n            >\n              \342\234\225\n            </button>\n          </div>\n\n          <div className=\"p-4 sm:p-5 space-y-4 max-h-[75vh] overflow-y-auto\">\n            {/* Angle cl\303\251 & opportunit\303\251 */}\n            <div className=\"p-3.5 bg-amber-50/60 border border-amber-200/70 rounded-xl text-xs\">\n              <span className=\"font-semibold text-amber-900 block mb-1\">\n                Angle d\'approche identifi\303\251 par l\'analyse locale :\n              </span>\n              <p className=\"text-amber-800 leading-relaxed\">{prospect.keyAngle}</p>\n            </div>\n\n            {/* Informations de contact direct */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n              <div>\n                <label className=\"block font-medium text-zinc-700 mb-1\">Email du prospect</label>\n                <div className=\"relative\">\n                  <MailIcon className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400\" />\n                  <input\n                    type=\"email\"\n                    value={emailInput}\n                    onChange={(e) => setEmailInput(e.target.value)}\n                    placeholder=\"contact@entreprise.fr\"\n                    className=\"w-full pl-8 pr-3 py-1.5 bg-zinc-50 border border-zinc-200 rounded-lg text-zinc-900 text-xs focus:bg-white\"\n                  />\n                </div>\n              </div>\n              <div>\n                <label className=\"block font-medium text-zinc-700 mb-1\">T\303\251l\303\251phone</label>\n                <div className=\"relative\">\n                  <Phone className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400\" />\n                  <input\n                    type=\"text\"\n                    value={prospect.phone || \"\"}\n                    readOnly\n                    placeholder=\"Non r\303\251pertori\303\251\"\n                    className=\"w-full pl-8 pr-3 py-1.5 bg-zinc-50 border border-zinc-200 rounded-lg text-zinc-600 text-xs cursor-default\"\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Param\303\250tres de r\303\251daction IA */}\n            <div className=\"p-3.5 bg-zinc-50 border border-zinc-200 rounded-xl space-y-3 text-xs\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-semibold text-zinc-900 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-zinc-800\" />\n                  Personnalisation de l\'email\n                </span>\n                <span className=\"text-[11px] text-zinc-500 font-mono\">gemini-flash-latest</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                <div>\n                  <label className=\"block font-medium text-zinc-600 mb-1\">Ton de l\'email</label>\n                  <select\n                    value={tone}\n                    onChange={(e) => setTone(e.target.value)}\n                    className=\"w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-lg text-zinc-800\"\n                  >\n                    <option value=\"Direct et courtois\">Direct et courtois</option>\n                    <option value=\"Chaleureux et orient\303\251 entraide locale\">Chaleureux & local</option>\n                    <option value=\"Factuel et analytique\">Factuel et ax\303\251 ROI</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block font-medium text-zinc-600 mb-1\">Objectif principal</label>\n                  <select\n                    value={objective}\n                    onChange={(e) => setObjective(e.target.value)}\n                    className=\"w-full px-2.5 py-1.5 bg-white border border-zinc-200 rounded-lg text-zinc-800\"\n                  >\n                    <option value=\"Proposition d\'audit gratuit de 10 min\">Audit offert (10 min)</option>\n                    <option value=\"Partage d\'id\303\251es concr\303\250tes d\'optimisation\">Partage de 2-3 pistes rapides</option>\n                    <option value=\"Prise de contact informelle de proximit\303\251\">Rencontre locale informelle</option>\n                  </select>\n                </div>\n              </div>\n\n              <button\n                onClick={handleGenerateEmail}\n                disabled={generating}\n                className=\"w-full py-2 px-3 bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg font-medium transition-colors flex items-center justify-center gap-1.5 disabled:opacity-50\"\n              >\n                {generating ? (\n                  <>\n                    <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>R\303\251daction sur mesure en cours...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3.5 h-3.5 text-amber-300\" />\n                    <span>{subject ? \"R\303\251g\303\251n\303\251rer l\'email\" : \"G\303\251n\303\251rer l\'email personnalis\303\251\"}</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* Email r\303\251dig\303\251 */}\n            {subject && (\n              <div className=\"space-y-2 text-xs\">\n                <div>\n                  <label className=\"block font-medium text-zinc-700 mb-1\">Objet de l\'email</label>\n                  <input\n                    type=\"text\"\n                    value={subject}\n                    onChange={(e) => setSubject(e.target.value)}\n                    className=\"w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-lg text-zinc-900 font-medium\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-medium text-zinc-700 mb-1\">Corps du message</label>\n                  <textarea\n                    rows={8}\n                    value={body}\n                    onChange={(e) => setBody(e.target.value)}\n                    className=\"w-full p-3 bg-white border border-zinc-200 rounded-lg text-zinc-900 leading-relaxed font-sans\"\n                  />\n                </div>\n\n                <div className=\"flex flex-wrap items-center justify-between gap-2 pt-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={handleCopy}\n                      className=\"px-3 py-1.5 border border-zinc-200 hover:bg-zinc-50 rounded-lg text-zinc-700 font-medium transition-colors flex items-center gap-1.5\"\n                    >\n                      {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                      <span>{copied ? \"Copi\303\251\" : \"Copier le texte\"}</span>\n                    </button>\n\n                    <button\n                      onClick={handleCreateDraft}\n                      disabled={drafting || !gmailToken}\n                      className=\"px-3 py-1.5 border border-zinc-200 hover:bg-zinc-50 rounded-lg text-zinc-700 font-medium transition-colors flex items-center gap-1.5 disabled:opacity-40\"\n                      title={!gmailToken ? \"Connectez Gmail pour cr\303\251er un brouillon\" : \"\"}\n                    >\n                      {drafting ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <FileEdit className=\"w-3.5 h-3.5\" />}\n                      <span>Cr\303\251er brouillon Gmail</span>\n                    </button>\n                  </div>\n\n                  <button\n                    onClick={handleSendViaGmail}\n                    disabled={sending || !gmailToken || !emailInput}\n                    className=\"px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-medium transition-colors flex items-center gap-1.5 disabled:opacity-40 shadow-xs\"\n                    title={!gmailToken ? \"Connectez Gmail ci-dessus\" : !emailInput ? \"Renseignez un email\" : \"\"}\n                  >\n                    {sending ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Send className=\"w-3.5 h-3.5\" />}\n                    <span>Envoyer avec Gmail</span>\n                  </button>\n                </div>\n              </div>\n            )}\n\n            {actionSuccess && (\n              <div className=\"p-2.5 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-xs flex items-center gap-1.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                <span>{actionSuccess}</span>\n              </div>\n            )}\n\n            {actionError && (\n              <div className=\"p-2.5 bg-rose-50 border border-rose-200 text-rose-800 rounded-lg text-xs flex items-center gap-1.5\">\n                <AlertCircle className=\"w-4 h-4 text-rose-600 shrink-0\" />\n                <span>{actionError}</span>\n              </div>\n            )}\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );\n};\n"
    num_lines: 408
    num_bytes: 16107
  }
}
